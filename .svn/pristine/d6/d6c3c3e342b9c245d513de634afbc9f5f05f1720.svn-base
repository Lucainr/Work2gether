<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>


<link rel="stylesheet" href="${pageContext.request.contextPath }/resources/css/provider/provStat.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>




<!-- 매출 컨테이너 -->
<div class="sales-container">
    <!-- 오늘의 매출 컨테이너 -->
    <div class="sales-item today-sales">
        <h5>전년도 매출</h5>
        <p id="todaySalesAmount"></p>
    </div>

    <!-- 올해의 매출 컨테이너 -->
    <div class="sales-item year-sales">
        <h5>올해의 매출</h5>
        <p id="yearSalesAmount"></p>
    </div>
</div>


		
<div class="table-responsive">
    <div class="categories">
        <table class="table">
            <tr>
                <th id="contType" class="stat">
                    <div class="d-flex align-items-center category-item">
                        <label>업종별 계약</label>
                    </div>
                </th>
                <th id="monthlyCont" class="stat">
                    <div class="d-flex align-items-center category-item">
                        <label>월별 계약</label>
                    </div>
                </th>
                <th id="contScale" class="stat">
                    <div class="d-flex align-items-center category-item">
                        <label>업체규모별 계약</label>
                    </div>
                </th>
                <th id="contEmpcnt" class="stat">
                    <div class="d-flex align-items-center category-item">
                        <label>사용인원별 계약</label>
                    </div>
                </th>
                <th id="contStorage" class="stat">
                    <div class="d-flex align-items-center category-item">
                        <label>스토리지별 계약</label>
                    </div>
                </th>
            </tr>
        </table>  
        <div class="input-group" style="width : 150px;">
            <label class="form-label" id="yearText">연도</label>
            <select id="selectYear" class="form-select"></select>
        </div>
    </div>  
</div>   
<div class="chart-container">
    <canvas id="statChart"></canvas>
</div>


 
<script>
	const contextPath = "${pageContext.request.contextPath}";
</script>
<script src="${pageContext.request.contextPath }/resources/js/app/provider/provStat.js"></script>

