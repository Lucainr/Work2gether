<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>


<script src="${pageContext.request.contextPath }/resources/js/app/room/roomTime.js"></script>
<link rel="stylesheet" type="text/css" href="${pageContext.request.contextPath}/resources/css/room/room.css"> 


<c:forEach var="room" items="${roomList}">
    <!-- 특정 roomId에 해당하는 시설만 출력 -->
    <c:if test="${room.roomId == roomId}">
       <h3 id="page-title">시설 정보</h3>


       
        <div class="facility-wrapper">
             <table class="table table-bordered">
                <tr>
                    <td class="facility-image" rowspan="6">
                        <img src="data:image/*;base64,${room.base64Img}" alt="시설 이미지" />
                    </td>
                    <td>호수</td>
                    <td id="roomHosu">${room.roomHosu}</td>
                </tr>
                <tr>
                    <td>이름</td>
                    <td id="roomName">${room.roomName}</td>
                </tr>
                <tr>
                    <td>수용인원</td>
                    <td id="roomNum">${room.roomNum}</td>
                </tr>
                <tr>
                    <td>시설상세정보</td>
                    <td id="roomDetail">${room.roomDetail}</td>
                </tr>
                <tr>
                    <td>사용 가능 여부:</td>
                    <td>
				      <c:choose>
				        <c:when test="${room.roomYn == '1'}">
				            예약 가능
				        </c:when>
				        <c:when test="${room.roomYn == '2'}">
				            점검 및 유지보수중
				        </c:when>
				        <c:when test="${room.roomYn == '3'}">
				            설비 고장
				        </c:when>
				        <c:when test="${room.roomYn == '4'}">
				            전력 및 통신 문제
				        </c:when>
				        <c:when test="${room.roomYn == '5'}">
				            청소 및 준비 시간
				        </c:when>
				        <c:when test="${room.roomYn == '6'}">
				            회사 행사
				        </c:when>
				        <c:when test="${room.roomYn == '7'}">
				            시설 임대
				        </c:when>
				        <c:otherwise>
				            알 수 없음
				        </c:otherwise>
				    </c:choose>
                    </td>
                </tr>
            </table>
        </div>
    </c:if>
</c:forEach>

<!-- 회차 선택 -->

<div class="time-and-info-wrapper">
    <!-- 타임 테이블 -->
    <div class="time-selection">
        <table class="table table-bordered text-center">
            <tbody>
                <tr>
                    <c:forEach var="roomTime" items="${roomTime}" varStatus="status">
                    
                        <td >
                        <!-- room.roomYn == '1'이 아닌 경우 모든 버튼을 예약 불가능으로 설정 -->
                        	
                            <!-- 예약 가능 버튼 -->
                           <c:if test="${roomTime.roomtimeYn == 'Y' && roomTime.room.roomYn == '1' }">
						        <button 
						            type="button" 
						            id="btn-time" 
						            class="btn btn-outline-primary" 
						            data-time-code="${roomTime.timeReser.timeCode}" 
						            data-time-range="${roomTime.timeReser.timeRange}">
						            ${roomTime.timeReser.timeRange}<br>(예약 가능)
						        </button>
						    </c:if>
                              <!-- 예약 불가능 버튼 -->
						    <c:if test="${roomTime.roomtimeYn != 'Y' || roomTime.room.roomYn != '1' }">
						        <button 
						        	style="font-weight: bold;"
						            type="button" 
						            id="btn-time" 
						            class="btn btn-danger" 
						            data-time-code="${roomTime.timeReser.timeCode}" 
						            data-time-range="${roomTime.timeReser.timeRange}" 
						            disabled 
						            title="${roomTime.room.roomYn != '1'  ? '시설을 사용할 수 없습니다' : ''}">
						            ${roomTime.timeReser.timeRange}<br>${myEmp.empName}
						        </button>
						    </c:if>
                        </td>
                        <!-- 행 분리 (3열마다 새 행 시작) -->
                        <c:if test="${status.index % 3 == 2}">
                            </tr><tr>
                        </c:if>
                    </c:forEach>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- 내가 선택한 정보와 오늘 날짜 -->
    <div class="room-reservation mt-4">
        <h5><span class="icon">✔</span> 선택정보</h5>
        <table class="table table-bordered">
            <tbody>
                <tr>
                    <th>선택 날짜</th>
                    <td id="selected-date"></td> <!-- 기본값 -->
                </tr>
                <tr>
                    <th>선택 회차</th>
                    <td id="selected-times"></td> <!-- 선택된 시간 출력 -->
                </tr>
            </tbody>
        </table>
        <button id="modal-button" class="btn btn-primary mt-3" data-bs-toggle="modal" 
        data-bs-target="#basicModal" disabled="disabled">예약하기</button>
    </div>
</div>



<!-- 예약을 확인하고 최종으로 예약하는 모달 -->
<div class="modal fade" id="basicModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
      <input type="hidden" id="hiddenCompanyId" value="${companyId}">
      <input type="hidden" id="hiddenRoodId" value="${roomId}">
      <c:forEach var="roomTime" items="${roomTime}">
      <input type="hidden" id="hiddenTimecode" value="${roomTime.timeCode}">
      </c:forEach>
        <!-- <h5 class="modal-title">예약 확인</h5> -->
        <h3 id="page-title">예약 확인</h3>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
     
        <table class="table table-bordered">
          <tbody>
            <tr>
              <td>시설</td>
              <td>
                <img id="modal-facility-image" src="" alt="시설 이미지" style="width:100%; height:100%; object-fit:cover;" />
              </td>
            </tr>
            <tr>
              <td>호수</td>
              <td id="modal-room-hosu"></td>
            </tr>
            <tr>
              <td>이름</td>
              <td id="modal-room-name"></td>
            </tr>
            <tr>
              <td>번호</td>
              <td id="modal-room-num"></td>
            </tr>
            <tr>
              <td>상세정보</td>
              <td id="modal-room-detail"></td>
            </tr>
            <tr>
              <td>사용용도</td>
              <td>
              	<textarea  id="modal-roomReser-detail" class="form-control"></textarea>
             </td>
            </tr>
          </tbody>
        </table>
        <p><strong>선택 날짜:</strong> <span id="modal-selected-date"></span></p>
        <p><strong>선택 회차:</strong> <span id="modal-selected-times"></span></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">취소</button>
        <button type="button" id="confirm-reservation" class="btn btn-primary" 
        data-url="${pageContext.request.contextPath}/${companyId }/roomTime/${roomId}/reser">
        예약하기</button>
      </div>
    </div>
  </div>
</div>
