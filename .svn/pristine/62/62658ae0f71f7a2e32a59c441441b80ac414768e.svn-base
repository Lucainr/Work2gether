@charset "UTF-8";

/* 기본적으로 collapse는 숨김 */
.collapse {
    display: none;
    transition: all 0.3s ease-in-out;
}

.collapse.show {
    display: flex; /* ✅ 플렉스 박스로 수정 */
    justify-content: space-between;
    gap: 20px;
    padding: 20px;
    border-top: 1px solid #ddd;
}

/* 전체 컨테이너 레이아웃 */
#chartContainer {
    display: flex;
    justify-content: space-between; /* 양쪽으로 분리 */
    align-items: flex-start;
    padding: 20px;
    gap: 20px;
}

/* 파이 차트 스타일 */
#scaleChart {
    flex: 1;  /* 차트가 왼쪽에 크게 위치 */
    max-width: 60%;
    height: auto;
}

/* 차트와 테이블을 좌우 배치 */
#statsChartContainer {
    flex: 1;
    max-width: 50%;
}

#statsTablesContainer {
    flex: 1;
    max-width: 50%;
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.stats-table {
    border: 1px solid #ddd;
    padding: 10px;
    border-radius: 5px;
    background: #f9f9f9;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.stats-table h4 {
    text-align: center;
    font-size: 18px;
}

.stats-table table {
    width: 100%;
    border-collapse: collapse;
}

.stats-table th, .stats-table td {
    border: 1px solid #ccc;
    padding: 8px;
    text-align: center;
}

.stats-table th {
    background-color: #f1f1f1;
    font-weight: bold;
}
