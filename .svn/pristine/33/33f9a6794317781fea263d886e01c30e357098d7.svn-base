<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%@ taglib uri="http://www.springframework.org/tags/form" prefix="form" %>


<%--CSS연결--%>
<link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/approval/approvalForm.css">

<%--우리는 타일즈 양식이니까 div컨테이너로 적절히 분배하는게 나아보임 이름구분을 명확히해서 구성하기--%>
<div class="approval-container">
    <!--양식 선택 영역 -->
    <div class="form-select-area">
        <div class="select-box-wrapper">
            <label for="formSelect">결재 양식 선택</label>
            <select id="formSelect" class="form-select">
                <option value="">-- 양식을 선택하세요 --</option>
                <c:forEach items="${formTitles}" var="form">
                    <option value="${form.apprformId}">${form.apprformNm}</option>
                </c:forEach>
            </select>
        </div>
        <!-- 버튼 그룹을 여기로 이동 -->
        <div class="button-group" style="display: none;">
            <button type="button" id="modifyBtn" class="btn modify-btn">수정</button>
            <button type="button" id="nextBtn" class="btn next-btn">다음</button>
            <button type="button" id="setApprovalBtn" class="btn btn-primary"
                    data-bs-toggle="modal" data-bs-target="#approvalLineModal">결재선 지정하기</button>
        </div>
    </div>

    <!--분기시점 - 휴가 신청서를 클릭했을때 -->
    <div id="vacationFormContainer" class="vacation-form-container" style="display: none;">
        <!-- 연차 현황 테이블 이거로 내 연차 현황을 확인 하는거임-->
        <div class="vacation-status">
            <h3>연차 현황</h3>
            <table class="vacation-table">
                <tr>
                    <th>총 연차</th>
                    <th>사용 연차</th>
                    <th>잔여 연차</th>
                    <th>병가 사용</th>
                </tr>
                <tr>
                    <td>-</td>
                    <td>-</td>
                    <td>-</td>
                    <td>-</td>
                </tr>
            </table>
        </div>

        <!-- 휴가 신청 양식 폼 -->
        <div class="vacation-input-form">
            <h3>휴가 신청</h3>
            <form id="vacationForm">
                <div class="form-group">
                    <label for="vacationType">휴가 종류</label>
                    <select id="vacationType" name="vacCode" required>
                        <!-- 휴가 종류 옵션이 들어갈 자리 -->
                    </select>
                </div>

                <div class="form-group">
                    <label for="startDate">시작일</label>
                    <input type="date" id="startDate" name="vacStartdate" required>
                </div>

                <div class="form-group">
                    <label for="endDate">종료일</label>
                    <input type="date" id="endDate" name="vacEnddate" required>
                </div>

                <div class="form-group">
                    <label for="reason">사유</label>
                    <textarea id="reason" name="vacReason" required></textarea>
                </div>

                <button type="button" id="previewBtn" class="btn preview-btn">작성 미리보기</button>
            </form>
        </div>
    </div>

    <!-- 미리보기 영역 -->
    <div id="previewContainer" class="preview-container" style="display: none;">
        <!-- A4 문서가 표시될 영역 -->
        <div class="document-area">
            <!-- 여기에 문서 내용이 렌더링됨 -->
        </div>
    </div>
</div>

<div class="modal fade" id="approvalLineModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <!-- 모달 헤더 -->
            <div class="modal-header">
                <h5 class="modal-title">결재라인 지정</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- 모달 바디 -->
            <div class="modal-body">
                <div class="row">
                    <!-- 왼쪽: 조직도 트리 -->
                    <div class="col-5">
                        <div class="org-tree">
                            <ul id="orgTree">
                                <li class="folder">
                                    <span>유한회사</span>
                                    <ul>
                                        <li class="folder">
                                            <span>수석/시 유한팀</span>
                                            <ul>
                                                <li><span>개발1팀</span></li>
                                                <li><span>개발2팀</span></li>
                                            </ul>
                                        </li>
                                    </ul>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- 오른쪽: 결재자 지정 -->
                    <div class="col-7">
                        <!-- 결재자 목록 -->
                        <div class="approver-list">
                            <h6>결재자</h6>
                            <table class="table">
                                <thead>
                                <tr>
                                    <th>순서</th>
                                    <th>부서</th>
                                    <th>이름</th>
                                    <th>직책</th>
                                    <th></th>
                                </tr>
                                </thead>
                                <tbody id="approverList">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 모달 푸터 -->
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">취소</button>
                <button type="button" class="btn btn-primary" id="saveApprovalLine">확인</button>
            </div>
        </div>
    </div>
</div>


<!-- JavaScript 파일 연결 -->
<script src="${pageContext.request.contextPath}/resources/js/app/approval/approvalForm.js"></script>

<script>
    var vacationStatusUrl = '${pageContext.request.contextPath}/${companyId}/approval/vacation/status';
    var vacationTypeUrl = '${pageContext.request.contextPath}/${companyId}/approval/vacation/types';
    var preViewTypeUrl = '${pageContext.request.contextPath}/${companyId}/approval/{formId}/preview';
    var orgTreeUrl = '${pageContext.request.contextPath}/${companyId}/approval/orgTree';
    var empUrl = '${pageContext.request.contextPath}/${companyId}/approval/employees';
</script>
