<%@ page language="java" contentType="text/html; charset=UTF-8"
         pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>
<%@ taglib prefix="security" uri="http://www.springframework.org/security/tags" %>

<link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/notice/noticeList.css"/>

<security:authorize access="isAuthenticated()">
    <security:authentication property="principal" var="principal"/>
    <c:set value="${principal.account.companyId }" var="companyId"/>
</security:authorize>

<h3 id="page-title">공지사항 리스트</h3>
<hr/>

<!-- 검색 폼 추가 -->
<div id="searchUI" class="row justify-content-end">
    <div class="col-auto">
        <form class="search-form" id="searchForm">
            <input type="hidden" name="page" />
            <div class="input-group">
                <select name="searchType" class="form-select">
                    <option value="title">제목</option>
                </select>
                <input type="text" name="searchWord" class="form-control" value="${simpleCondition.searchWord}"/>
                <button type="button" class="btn btn-primary" id="searchBtn">검색</button>
                <br/>
            </div>
        </form>
    </div>
</div>



<table class="table table-bordered">
    <thead>
    <tr>
        <th>번호</th>
        <th>제목</th>
        <th>작성자</th>
        <th>작성일</th>
    </tr>
    </thead>
    <tbody>
    <c:choose>
        <c:when test="${not empty noticeList}">
            <c:forEach items="${noticeList}" var="notice">
                <tr class="notice-list" data-notice-no="${notice.noticeNo}">
                    <td>${notice.rnum}</td>
                    <td>
                        <c:url value="/${companyId}/notice/${notice.noticeNo}" var="detailUrl" />
                        <!-- 중요 공지 여부에 따른 강조 처리 -->
                        <span class="notice-link">  <!-- a태그를 span으로 변경 -->
                            <c:choose>
                                <c:when test="${notice.noticeImportant eq 'Y'}">
                                    <strong> 🚨 ${notice.noticeName} </strong>
                                </c:when>
                                <c:otherwise>
                                    ${notice.noticeName}
                                </c:otherwise>
                            </c:choose>
                        </span>
                    </td>
                    <td>${notice.employee.empName}</td>
                    <td>${notice.noticeDate}</td>
                </tr>
            </c:forEach>
        </c:when>
        <c:otherwise>
            <tr>
                <td colspan="4">등록된 공지사항이 없습니다.</td>
            </tr>
        </c:otherwise>
    </c:choose>
    </tbody>
</table>


<!-- 글쓰기 버튼 -->
<security:authorize access="isAuthenticated()">
    <security:authentication property="principal" var="principal" />
    <c:if test="${principal.account.posiId == '7'}">
        <div class="text-end mt-3">
            <c:url value="/${companyId}/notice/newForm" var="writeUrl" />
            <a href="${writeUrl}" class="btn btn-primary">글쓰기</a>
        </div>
    </c:if>
</security:authorize>

<br/>

<!-- 페이지네이션 -->
<div class="paging-area">
    ${pagingHTML}
</div>

<script>
    function paging(page) {
        searchForm.page.value = page;
        searchForm.submit();
    }

    // 검색 버튼 클릭 이벤트
    document.getElementById("searchBtn").addEventListener("click", function(){
        const searchWord = document.querySelector('input[name="searchWord"]').value;
        const searchType = document.querySelector('select[name="searchType"]').value;

        let form = document.getElementById("searchForm");
        form.page.value = "1";
        form.submit();
    });

    // 기존의 notice-list 클릭 이벤트는 그대로 유지
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.notice-list').forEach(row => {
            row.addEventListener('click', function(e) {
                const noticeNo = this.getAttribute('data-notice-no');
                if (noticeNo) {
                    location.href = contextPath + '/' + companyId + '/notice/' + noticeNo;
                }
            });
        });
    });
</script>

