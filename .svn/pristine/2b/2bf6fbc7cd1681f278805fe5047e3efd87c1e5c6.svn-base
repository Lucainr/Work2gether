@charset "UTF-8";

.chart-container {
    display: flex;
    justify-content: center; /* 수평 가운데 정렬 */
    align-items: center;     /* 수직 가운데 정렬 */
    height: 100%;            /* 부모 요소의 높이 기준 */
    width: 100%;             /* 부모 요소의 너비 기준 */
}

.categories {
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin: 20px 0;
  padding: 10px 0;
  border-bottom: 2px solid #ccc;
}

.category-item {
  padding: 10px 20px;
  background-color: #f8f9fa;
  border: 1px solid #ddd;
  border-radius: 5px;
  text-align: center;
  cursor: pointer;
  transition: all 0.3s ease;
}

.category-item:hover {
  background-color: #e9ecef;
  border-color: #007bff;
  color: #007bff;
}

.category-item.active {
  background-color: #007bff;
  color: white;
  border-color: #0056b3;
}


/* 기본 상태 스타일 - 테두리 제거, 텍스트만 강조 */
.stat {
    cursor: pointer;
    padding: 10px 20px;
    border: none;  /* 테두리 제거 */
    border-radius: 0;
    background: none;  /* 배경 제거 */
    font-size: 18px;
    font-weight: normal;
    color: #333;
    transition: color 0.3s ease-in-out;
}

/* 호버 시 강조 */
.stat:hover {
    color: #007bff;  /* 파란색 강조 */
    text-decoration: underline; /* 밑줄 강조 */
}

/* 클릭(활성화) 효과 */
.stat.active {
    color: #007bff;
    font-weight: bold;  /* 글자 강조 */
    text-decoration: underline; /* 밑줄 강조 */
    border-bottom: 2px solid #007bff; /* 밑줄 추가 */
}

#yearText {
	margin-right : 10px;
	margin-top : 10px;
	font-size : 1.0rem;
}

/* 매출 컨테이너 전체 스타일 */
/* 매출 컨테이너 전체 스타일 */
.sales-container {
    display: flex;
                   
    justify-content: center;  /* 요소들을 가운데 정렬 */
    gap: 20px; /* 요소 간의 간격 조정 */
    padding: 20px;
    border: 2px solid #ddd;
    border-radius: 10px;
    margin-bottom: 20px;
    background-color: #f9f9f9;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    max-width: 600px; /* 컨테이너 너비 줄이기 */
    margin: 0 auto; /* 페이지 중앙 배치 */
}

/* 개별 매출 항목 스타일 */
.sales-item {
    text-align: center;
    padding: 10px;  /* 패딩 줄이기 */
    border-radius: 10px;
    flex: none;  /* 동일한 크기로 강제하지 않고, 지정된 크기 사용 */
    width: 250px;  /* 박스 크기 조정 */
    height: 100px;  /* 높이 줄이기 */
    background: white;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    display: flex;
    flex-direction: column;
    justify-content: center;
}

/* 오늘의 매출과 올해의 매출 색상 구분 */
.today-sales {
    border: 2px solid #4caf50;
}

.year-sales {
    border: 2px solid #2196F3;
}

/* 텍스트 크기 조정 */
#todaySalesAmount, #yearSalesAmount {
    font-size: 1.2rem;  /* 글씨 크기 줄이기 */
}






