document.addEventListener('DOMContentLoaded', function() {
    // 요소들 나열하기
    const formSelect = document.getElementById('formSelect');
    const vacationFormContainer = document.getElementById('vacationFormContainer');
    const previewContainer = document.getElementById('previewContainer');
    const vacationForm = document.getElementById('vacationForm');
    const previewBtn = document.getElementById('previewBtn');
    const modifyBtn = document.getElementById('modifyBtn');
    const nextBtn = document.getElementById('nextBtn');
    const buttonGroup = document.querySelector('.button-group');

    //페이지 로딩할때 실행바로하기
    loadOrgTreeWithEmployees();

    // 조직도 데이터와 사원 데이터를 함께 로드 - 어차피 둘중에 하나라도 못불러오면 망하는거니까
    async function loadOrgTreeWithEmployees(){
        try{
            //병렬로 데이터를 그냥 같이 로딩해버리자
            const [orgResp, empResp] = await Promise.all([
                fetch(orgTreeUrl),
                fetch(empUrl)
            ]);
            //둘다 제이슨으로 받을때까지 기다리기
            const [orgData, empData] = await Promise.all([
                orgResp.json(),
                empResp.json()
            ]);

            //부서별 사원 맵 생성
            const employeeByDept = {};
            empData.forEach(emp => {
                // 디버깅 로그 추가
                console.log("처리중인 사원:", emp);

                if (!employeeByDept[emp.departCode]){
                    employeeByDept[emp.departCode] = []; //없으면 빈 배열을 생성하겠다는 뜻임
                }
                employeeByDept[emp.departCode].push(emp); // 내번호에 내거집어넣겠다는뜻임
            });
            // 최종 맵 확인
            console.log("부서별 사원 맵:", employeeByDept);

            //트리 데이터 구성 할 때 사원 정보도 포함 시키기
            const treeData = buildTreeDataWithEmployees(orgData, employeeByDept);

            //트리 HTML 생성 및 삽입
            const treeHtml = renderTreeWithEmployees(treeData);
            document.getElementById('orgTree').innerHTML = treeHtml;
        }catch (error){
            console.error('데이터 로딩 중 에러 발생했네!! : ', error);
        }
    }

    function buildTreeDataWithEmployees(departments, employeesByDept) {
        const tree = [];
        const map = {};

        // 부서상태가 Y인 활성화 부서 상태만 갖고와야함 이거 검증안했다가 오류났음
        const activeDepts = departments.filter(dept => dept.departStatus === 'Y');

        // 부서 노드를 생성한다음에 거기에 사원정보를 추가한다
        activeDepts.forEach(dept => {
            //map 객체의 역할 : departCode를 키로 사용하여, 부서 데이터와 관련된 정보를 저장.

            // 예: map['D001'] = { departCode: 'D001', departName: '개발1팀', ... }
            map[dept.departCode] = {
                // ...dept는 스프레드 연산자로, 기존 부서 객체의 모든 속성을 복사한다
                ...dept,
                children: [],
                employees: employeesByDept[dept.departCode] || []
            };
            //map[dept.departCode] = { ... } 이 부분에서 기존 데이터가 복사되어 덮어씌워지는 구조.
            // <- 오른쪽에서 왼쪽으로 가잖아
        });

        //부모 자식관계 만들기
        activeDepts.forEach(dept => {
            //부모가 있고, 그 부모가 map에 존재하는 경우에만 처리 이거안했다가 오류났음
            if (dept.departParentcode && map[dept.departParentcode]){ // 부모 부서가있다면?
                // 부모가 있으면 부모부서의 children 배열에 현재 부서 추가하기
                map[dept.departParentcode].children.push(map[dept.departCode]);
            } else if (!dept.departParentcode) {
                // 부모가없거나 부모가 map에 없는 경우 최상위 노드로 처리해버리자
                tree.push(map[dept.departCode]);
            }
        });
        console.log('생성된 트리 구조:', tree);  // 디버깅용
        return tree;
    }

    function renderTreeWithEmployees(node) {
        if (!Array.isArray(node) || node.length === 0) return '';

        //시작
        let html = '<ul>';
        node.forEach(item => {
            if (!item) return;

            //실제 렌더링시킬 데이터들 html에 추가하기
            html += `<li class="folder">`;

            //부서 정보
            html += `<span data-code="${item.departCode}" data-head="${item.departHead || ''}">${item.departName}</span>`;

            //사원 목록
            if (item.employees && item.employees.length > 0) {
                html += '<ul class="employees">';

                //부서장을 먼저 표시하기 (클라이언트단에서해버리자)
                const head = item.employees.find(emp => emp.empId === item.departHead);
                if (head) {
                    html += `<li class="department-head">
                        <span data-emp-id="${head.empId}">
                            ${head.posiName} ${head.empName} (부서장)
                        </span>
                    </li>`
                }

                //나머지 사원들을 표시하기 얘네들은 일반사원임
                item.employees
                    .filter(emp => emp.empId !== item.departHead)
                    .forEach(emp => {
                        html += `<li class="employee">
                            <span data-emp-id="${emp.empId}">
                                ${emp.posiName} ${emp.empName}
                            </span>
                        </li>`;
                    });
                html += '</ul>';
            }

            // 하위 부서가 있으면 재귀적으로 렌더링
            if (Array.isArray(item.children) && item.children.length > 0){
                html += renderTreeWithEmployees(item.children);
            }
            html += `</li>`;
        });
        html += '</ul>';
        return html;

    }

    // 트리 노드 클릭 이벤트 처리
    document.getElementById('orgTree').addEventListener('click', function(e) {
        const span = e.target.closest('span');
        if (!span) return;

        // 선택된 부서/사원 처리
        const deptInfo = {
            code: span.dataset.code,
            name: span.textContent,
            head: span.dataset.head || ''
        };

        console.log('선택된 부서:', deptInfo);

        const li = span.closest('li');
        if (li.classList.contains('folder')) {
            li.classList.toggle('open');
        }
    });

    // 결재자 추가 함수
    function addApprover(emp) {
        const tbody = document.getElementById('approverList');
        const row = document.createElement('tr');
        row.innerHTML = `
            <td>${tbody.children.length + 1}</td>
            <td>${emp.departmentName}</td>
            <td>${emp.name}</td>
            <td>${emp.position}</td>
            <td><button type="button" class="btn btn-sm btn-danger">삭제</button></td>
        `;
        tbody.appendChild(row);
    }

    // 휴가 신청서 선택 시 이벤트
    formSelect.addEventListener('change', function() {
        const selectedValue = this.value;

        // 휴가 신청서가 선택되었을 때 실행되는거임
        if (selectedValue === 'v01') { //이렇게 대놓고 하드코딩할게아니라 이건 여러경우의수를 대비해야할듯
            // 연차 현황 데이터 가져오기
            vacationStatus();
            // 휴가 종류 데이터 가져오기
            fetchVacationTypes();
            // 폼 보이기
            vacationFormContainer.style.display = 'block';
        } else {
            vacationFormContainer.style.display = 'none';
            previewContainer.style.display = 'none';
        }
    });

    // 연차 현황 조회
    function vacationStatus() {
        // Form에서 써둔거 갖고오기
        fetch(vacationStatusUrl)
            .then(resp => resp.json())
            .then(data => {
                updateVacationStatusTable(data);
            })
            .catch(error => console.error('Error:', error));
    }

    // 휴가 종류 조회
    function fetchVacationTypes() {
        fetch(vacationTypeUrl)
            .then(response => response.json())
            .then(data => {
                updateVacationTypeSelect(data);
            })
            .catch(error => console.error('Error:', error));
    }

    // 날짜 유효성 검사
    const startDate = document.getElementById('startDate');
    const endDate = document.getElementById('endDate');

    startDate.addEventListener('change', validateDates);
    endDate.addEventListener('change', validateDates);

    function validateDates() {
        const start = new Date(startDate.value);
        const end = new Date(endDate.value);

        if (end < start) {
            alert('종료일은 시작일보다 빠를 수 없습니다.');
            endDate.value = startDate.value;
            return false;
        }

        // 주말 체크
        if (isWeekend(start) || isWeekend(end)) {
            alert('주말은 선택할 수 없습니다.');
            return false;
        }

        return true;
    }

    function isWeekend(date) {
        const day = date.getDay();
        return day === 0 || day === 6;
    }

    // 미리보기 버튼 클릭 시
    previewBtn.addEventListener('click', async function () {
        //내가 결재문서양식을 찍으면 이게 정해짐
        const selectedFormId = document.getElementById('formSelect').value;
        let formData;

        //선택된 양식에 따라 다른 FormData 구성
        switch (selectedFormId) {
            //여기는 하드코딩할수밖에없을거같음 구별할수있는게 이거말곤없음
            case 'v01': //휴가신청서
                if (!validateDates()) return; // 휴가 전용 validation

                const selectedOption = document.getElementById('vacationType')
                    .options[document.getElementById('vacationType').selectedIndex];

                formData = {
                    vacationType: selectedOption.text, // 보여지는 텍스트니까 name을갖고가는거임
                    startDate: document.getElementById('startDate').value,
                    endDate: document.getElementById('endDate').value,
                    reason: document.getElementById('reason').value
                };
                break;

            // case 'p01': // 지출결의서
            //     formData = {
            //         paymentDate: document.getElementById('paymentDate').value,
            //         amount: document.getElementById('amount').value,
            //         category: document.getElementById('category').value,
            //         description: document.getElementById('paymentDesc').value
            //     };
            //     break;

        }

        //여기서 뭘받을지정해져버림 v01이면 이제 컨트롤러에서 휴가 문서 템플릿을꺼내오든지할거임
        const finalPreviewUrl = preViewTypeUrl.replace('{formId}', selectedFormId);

        const resp = await fetch(finalPreviewUrl, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(formData)
        });

        if (!resp.ok) throw new Error(`HTTP 에러인듯~~ status : ${resp.status}`);

        // 밑에거안되면 바로삭제하고 이거쓰기
        const html = await resp.text();
        previewContainer.innerHTML = html;

        // 문서 영역만 업데이트
        // const documentArea = document.querySelector('.document-area');
        // documentArea.innerHTML = await resp.text();

        // 문서와 버튼 표시
        previewContainer.style.display = 'block';
        vacationFormContainer.style.display = 'none';
        buttonGroup.style.display = 'flex';  // 버튼 그룹 표시
    });


    // 수정 버튼 클릭 시
    modifyBtn.addEventListener('click', function() {
        previewContainer.style.display = 'none';
        buttonGroup.style.display = 'none';
        vacationFormContainer.style.display = 'block';
    });

    // 다음 버튼 클릭 시 (결재선 지정 페이지로 이동)
    nextBtn.addEventListener('click', function() {
        alert("아직 미구현임");
    });

    // 연차 현황 테이블 업데이트
    function updateVacationStatusTable(data) {


        console.log("데이터 확인:", data); // 데이터가 제대로 왔는지 확인

        // 테이블 갖고오기
        // 자꾸까먹음 vacation-table은 클래스이름이므로 .을찍고찾아야함
        const table = document.querySelector('.vacation-table');

        // 데이터 행만 업데이트 (첫번째 tr는 냅두고 두 번째 tr만 적용)
        // <tr><th></th></tr> 이게 첫번째 <tr><td></td></tr> 이게 두번째
        const dataRow = table.rows[1];
        if (dataRow) {
            dataRow.innerHTML = `
            <td>${data.vstaAllcount}</td>
            <td>${data.vstaUse}</td>
            <td>${data.vstaNowcount}</td>
            <td>${data.vstaSickcount}</td>
        `;
        }
    }

    // 휴가 종류 선택박스 업데이트
    function updateVacationTypeSelect(data) {
        const select = document.getElementById('vacationType');
        select.innerHTML = '<option value="">선택하세요</option>';
        data.forEach(type => {
            // value에는 code를, 화면에 보여주는 텍스트는 name을 미리 지정해놔야한다
            select.innerHTML += `<option value="${type.vacCode}" data-name="${type.vacName}">${type.vacName}</option>`;
        });
    }

});