@charset "UTF-8";

.card.container {
    height: 800px; /* 예: 10명에 맞는 높이 (실제 높이에 맞게 조정) */
    overflow-y: auto; /* 내용이 넘칠 경우 스크롤바 생성 */
    max-height: 800px; /* 최대 높이 제한 */
    position: relative; /* 버튼 고정 위치 설정 */
}

#pagination {
    display: block;
}

#pagination.hidden {
    display: none;
}
/* 페이지네이션 컨테이너 스타일 */
.pagination-container {
    display: flex;
    flex : 1;
    justify-content: space-between; /* 양 끝에 배치 */
    align-items: center;
    gap: 10px;
    margin-top: 20px;
}

/* 페이지네이션 버튼 공통 스타일 */
.pagination-container button {
    border: 1px solid #ddd;
    background-color: #f8f9fa;
    color: #6c757d;
    padding: 8px 12px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.3s ease;
    gap:10px;
}

/* 활성 페이지 스타일 */
.pagination-container button.active {
    background-color: #6c5ce7;
    color: white;
    border: 1px solid #6c5ce7;
}


.filter-container {
  display: flex; /* 가로 정렬 */
  align-items: center; /* 세로 중앙 정렬 */
  gap: 20px; /* 요소 간의 기본 간격 */
  margin-bottom: 10px; /* 테이블과의 여백 */
}
  
.search-container {
  display: flex;
  align-items: center;
  position: relative;
  width: 200px;
  margin-left: auto; /* 검색창을 오른쪽 끝으로 정렬 */
}

.search-input {
  width: 100%;
  padding: 0.5rem 2.5rem 0.5rem 1rem;
  box-sizing: border-box;
}  

table {
    table-layout: auto; /* 자동으로 셀 너비 조정 */
    width: 100%;
}

th, td {
    white-space: nowrap;      /* 줄바꿈 방지 */
    overflow: hidden;         /* 넘치는 내용 숨기기 */
    text-overflow: ellipsis;  /* 넘치는 내용은 '...'로 표시 */
    padding: 8px;             /* 셀 안쪽 여백 */
}

th {
    text-align: center; /* 헤더 가운데 정렬 */
}

td {
    text-align: center; /* 내용 가운데 정렬 */
}


.th-content {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 5px; /* 텍스트와 화살표 사이 여백 */
}

.arrow {
    font-size: 12px; /* 화살표 크기 */
    line-height: 1;
}


.arrow.asc::after {
  content: "▲"; /* 오름차순 */
}

.arrow.desc::after {
  content: "▼"; /* 내림차순 */
}
 
/* .swal-container {
  z-index: 1301 !important;  MUI Drawer 기본 z-index보다 높은 값
} */
/* 일반적인 z-index 설정 */
.swal2-container {
  z-index: 1101; /* Bootstrap 모달보다 높은 값 설정 */
  pointer-events: auto !important;
}

.swal2-custom-popup {
  z-index: 1101 ;  /* 동일하게 높은 값 설정 */
}
.swal2-textarea {
    pointer-events: auto !important;
    cursor: text;
}
  
  
  