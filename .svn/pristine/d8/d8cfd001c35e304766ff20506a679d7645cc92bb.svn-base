
    .facility-wrapper {
        margin: 20px auto;
        max-width: 1000px; /* 테이블 최대 너비 */
        border: 1px solid #ddd;
        border-radius: 10px;
        overflow: hidden;
    }

    .facility-image {
        width: 55%; /* 이미지 가로 비율 */
        vertical-align: top;
    }

    .facility-image img {
        width: 100%; /* 이미지를 셀 너비에 맞춤 */
        height: auto; /* 비율 유지 */
        display: block;
        object-fit: cover; /* 이미지 채우기 */
        border-right: 1px solid #ddd; /* 오른쪽 경계선 */
    }

    .facility-info {
        padding: 15px;
    }

    .time-and-info-wrapper {
        display: flex;
        justify-content: space-between; /* 좌우로 배치 */
        gap: 20px; /* 두 영역 사이 간격 */
        align-items: flex-start; /* 위쪽 정렬 */
    }

    .time-selection {
        flex: 4; /* 시간 선택 테이블 영역 크기를 줄임 */
        
    }

    .room-reservation {
        flex: 3; /* 선택 정보 영역 크기를 늘림 */
        background-color: #f9f9f9; /* 배경색 */
        padding: 20px; /* 내부 여백 */
        
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* 그림자 */
    }

    .room-reservation h5 {
        margin-bottom: 15px;
        font-size: 20px;
    }

    .table {
        width: 100%;
        border-collapse: collapse; /* 셀 경계선 제거 */
    }

    .table th, .table td {
        padding: 12px; /* 셀 내부 여백 */
        text-align: left;
    }

    .btn {
        font-size: 13px; /* 버튼 글자 크기 */
        height: 50px; /* 버튼 높이 줄이기 */
        text-align: center;
        vertical-align: middle;
    }

   /*  .btn-primary {
        background-color: #007bff;
        color: white;
        border: none;
    } */

    .btn-primary:hover {
        background-color: #0056b3;
    }

    .btn-secondary {
        background-color: #6c757d;
        color: white;
        border: none;
    }

    .btn-secondary:hover {
        background-color: #5a6268;
    }

    
    