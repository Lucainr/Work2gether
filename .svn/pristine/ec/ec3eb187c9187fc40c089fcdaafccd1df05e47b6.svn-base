package kr.or.ddit.roomReservation.controller;

import java.util.List;

import javax.inject.Inject;
import javax.servlet.http.HttpSession;

import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.validation.BindingResult;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.ModelAttribute;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.ResponseBody;
import org.springframework.web.servlet.mvc.support.RedirectAttributes;

import kr.or.ddit.commons.enumpkg.ServiceResult;
import kr.or.ddit.employee.vo.EmployeeVO;
import kr.or.ddit.roomReservation.service.RoomReservationService;
import kr.or.ddit.roomReservation.vo.RoomReservationVO;
import lombok.extern.slf4j.Slf4j;

@Slf4j
@Controller
@RequestMapping("/{companyId}/roomTime")
public class RoomReservationController {
	
	@Inject
	private RoomReservationService service;


	public static final String MODELNAME = "roomReser";
	
	@ModelAttribute(MODELNAME)
	   public RoomReservationVO room() {
	      return new RoomReservationVO();
	   }
	
	
	
	
	// 시설 하나의 예약 현황
	@GetMapping("{roomId}/rList")
	@ResponseBody // JSON 데이터 반환
	public List<RoomReservationVO> roomReserList(@PathVariable("companyId") String companyId,
			@PathVariable("roomId") String roomId,
			
			HttpSession session,
			Model model
			) {
		EmployeeVO emp = (EmployeeVO) session.getAttribute("myEmp");
		//empId로 확인해서 삭제를 할 수 있어야하므로
		//근데 model에 있는 데이터는 뷰에 뿌려주고 사라짐
		//그래서 뷰에서는 세션에서 꺼내야하는것
		model.addAttribute("myEmp", emp);
		return service.readRoomEmpList(roomId);
	}
	
	
	
	
	
	
	//시설 예약 등록(모달/ ajax로)
		@PostMapping("{roomId}/reser")
		@ResponseBody
		public String insertRoomReser( @PathVariable("companyId") String companyId,
				@PathVariable("roomId") String roomId,
				@RequestBody RoomReservationVO roomReser,
				BindingResult errors,
				HttpSession session,
				RedirectAttributes redirectAttributes) {
			
			//로그인 한사람만 예약할 수 있음
			EmployeeVO emp = (EmployeeVO) session.getAttribute("myEmp");
	        if (emp != null) {
	        	roomReser.setEmpId(emp.getEmpId()); // EmployeeVO의 empId 필드 값 설정
	        } else {
	            redirectAttributes.addFlashAttribute("message", "로그인이 필요합니다.");
	            return "redirect:/{companyId}/login"; // 로그인 페이지로 리다이렉트
	        }
			
	        
	        //모달에서 받아온 타임코드와 범위
			List<String> timeCodes = roomReser.getTimeCodes(); //다중 선택때문에 List로
			log.info("============timeCodes==============={}",timeCodes.toString());
		    List<String> timeRanges = roomReser.getTimeRanges();
		    log.info("===========timeRanges================{}",timeRanges.toString());
		    
		    
		    //시간 코드와 범위가 널인지 확인
		    if (timeCodes == null || timeRanges == null) {
		        redirectAttributes.addFlashAttribute("message", "시간 데이터가 제공되지 않았습니다.");
		        return "redirect:/" + companyId + "/roomTime/" + roomId;
		    }

		    //코드와 범위의 사이즈가 일치하는지 확인
		    if (timeCodes.size() != timeRanges.size()) {
		        redirectAttributes.addFlashAttribute("message", "시간 코드와 범위 데이터의 개수가 일치하지 않습니다.");
		        return "redirect:/" + companyId + "/roomTime/" + roomId;
		    }
		    
		    //여기에 타임 코드 리스트를 넣어주면
		    roomReser.setTimeCodes(timeCodes); //가져온 타임코드 배열을 넣어주기
		    //여기서 서비스로 보내준다 >> 그럼 서비스에서 하나씩뺴서 넣어준다.
		    ServiceResult result = service.createRoomReser(roomReser);

		    if (result != ServiceResult.OK) {
		        redirectAttributes.addFlashAttribute("message", "예약 중 일부 또는 전체가 실패했습니다.");
		        return "redirect:/" + companyId + "/roomTime/" + roomId;
		    }

		    redirectAttributes.addFlashAttribute("message", "모든 예약이 성공적으로 처리되었습니다.");
		    return "redirect:/" + companyId + "/roomTime/" + roomId;
		}
	
	
		
		
		//예약한 것 삭제 --> 이것도 아작스로~비동기~json~
	@PostMapping("{reserId}/delete")
	@ResponseBody
	public String deleteReservation(
			@PathVariable("reserId") String reserId, 
			
			HttpSession session,
			Model model,
			RedirectAttributes redirectAttributes
			) {
		// 세션에서 myEmp 확인
		 EmployeeVO emp = (EmployeeVO) session.getAttribute("myEmp");
		    if (emp == null) {
		        redirectAttributes.addFlashAttribute("errorMessage", "로그인 정보가 없습니다. 다시 로그인 해주세요.");
		        return "redirect:/login"; // 로그인 페이지로 리다이렉트
		    }

		    ServiceResult result = service.removeRoomReser(reserId);
		    if (result != ServiceResult.OK) {
		        
		        return "room/roomList"; // 다시 예약 삭제 도전,,,
		    }

		    model.addAttribute("myEmp", emp);
		    return "redirect:room/roomList"; //다시 시설 리스트 페이지로 이동하기
	   
	}
	
	
	
	
	
	
}
