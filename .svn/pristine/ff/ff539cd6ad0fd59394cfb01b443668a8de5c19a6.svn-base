<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.or.ddit.room.dao.RoomMapper">

	<resultMap type="RoomVO" id="roomList" autoMapping="true">
		<association property="comCode" javaType="CommonCodeVO" autoMapping="true" />
	</resultMap>


	<select id="selectTotalRecord" resultType="int">
		SELECT COUNT(ROOM_ID)
		FROM ROOM
		WHERE 1=1
		 <include refid="searchFrag" />
	</select>
	
	<sql id="searchFrag">
		<if test="simpleCondition neq null">
			<if test="@org.apache.commons.lang3.StringUtils@isNotBlank(simpleCondition.searchWord)">
				AND R.ROOM_GORY = #{simpleCondition.searchWord}
			</if>
			
		</if>
	</sql>

	<select id="selectRoomList" resultMap="roomList">
		SELECT ROOM_ID
		,R.ROOM_HOSU
		,R.ROOM_NAME
		,R.ROOM_NUM
		,R.ROOM_IMG
		,R.ROOM_DETAIL
		,R.ROOM_YN
		,R.ROOM_GORY
		,C.CODE
		,C.CODE_COMMENT
		FROM ROOM R INNER JOIN COMMON_CODE C ON R.ROOM_GORY = C.CODE
		WHERE C.TABLE_NAME ='ROOM'
		<!-- <if test='roomGory neq null and roomGory neq "" '> AND R.ROOM_GORY 
			= #{roomGory} </if> <if test="keyword neq null and keyword neq ''"> AND R.ROOM_NAME 
			LIKE '%'||#{keyword}||'%' </if> -->
		<include refid="searchFrag" />
		ORDER BY R.ROOM_HOSU
	</select>

	<select id="selectRoom" resultType="kr.or.ddit.room.vo.RoomVO">
		SELECT ROOM_ID
		,ROOM_HOSU
		,ROOM_NAME
		,ROOM_NUM
		,ROOM_IMG
		,ROOM_DETAIL
		,ROOM_YN
		,ROOM_GORY
		FROM ROOM
		WHERE ROOM_ID = #{roomId}
	</select>

	<insert id="insertRoom">
		INSERT INTO ROOM(
		ROOM_HOSU
		,ROOM_NAME
		,ROOM_NUM
		,ROOM_IMG
		,ROOM_DETAIL
		,ROOM_YN
		,ROOM_GORY
		)
		VALUES(
		#{roomHosu,jdbcType=VARCHAR}
		, #{roomName,jdbcType=VARCHAR}
		, #{roomNum,jdbcType=NUMERIC}
		,
		#{roomImg,jdbcType=BLOB}
		, #{roomDetail,jdbcType=VARCHAR}
		,
		#{roomYn,jdbcType=VARCHAR}
		, #{roomGory,jdbcType=VARCHAR}
		)
	</insert>

	<update id="updateRoom">
		UPDATE ROOM
		SET
		ROOM_HOSU=#{roomHosu,jdbcType=VARCHAR}
		,ROOM_NAME=#{roomName,jdbcType=VARCHAR}
		,ROOM_NUM=#{roomNum,jdbcType=NUMERIC}
		,ROOM_IMG=#{roomImg,jdbcType=BLOB}
		,ROOM_DETAIL=#{roomDetail,jdbcType=VARCHAR}
		,ROOM_YN=#{roomYn,jdbcType=VARCHAR}
		,ROOM_GORY=#{roomGory,jdbcType=VARCHAR}
		WHERE ROOM_ID = #{roomId}


	</update>

	<delete id="deleteRoom">
		DELETE FROM ROOM
		WHERE ROOM_ID = #{roomId}
	</delete>

	<update id="deleteRoomImage">
		UPDATE ROOM
		SET ROOM_IMG=null
		WHERE ROOM_ID=#{roomId}
	</update>



</mapper>