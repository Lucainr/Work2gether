
let allYearList = [];  // 서버에서 연도 가져와서 담는 용도도
let contractStart = ""; // 연도 전역 변수 선언
let selectedStats = []; // 선택된 통계 유형 저장 (다중 선택 지원)


document.addEventListener("DOMContentLoaded", () => {
    fetchGetYearList('selectYear');
    totayTotal();
    yearTotal();

    var stat = document.querySelectorAll(".stat");
    const defaultStatType = "contType"; // 기본 로딩 차트를 업종으로 

    const yearSelect = document.querySelector("#selectYear");
    
    
    yearSelect.addEventListener("change", (e) => {
        contractStart = e.target.value;
        // 추가해야됨. function 호출     
    });   

        const statType = document.querySelector(".stat.active")?.id || "contType";
        
        fetch(`${contextPath}/prov/getStatData?statType=${statType}&contractStart=${contractStart}`)
        .then((resp) => {
            if(!resp.ok) throw new Error("기본 차트 로딩중 오류");
            return resp.json();
        })
        .then((data) => {
            console.log("기본 차트 조회 응답 데이터",data);
            drawChart(data,statType);
            activeCategory(statType);
        })
        .catch((error) => {
            console.log("기본 차트 조회중 에러발생 ", error);
        });




    // 페이지에 들어왔을때 기본으로 렌더링할 카테고리 (현재 : 업종)
        fetch(`${contextPath}/prov/getStatData?statType=${defaultStatType}&contractStart=${contractStart}`)
        .then((resp) => {
            if(!resp.ok) throw new Error("기본 차트 로딩중 오류");
            return resp.json();
        })
        .then((data) => {
            console.log("기본 차트 조회 응답 데이터",data);
            drawChart(data,defaultStatType);
            activeCategory(defaultStatType);
        })
        .catch((error) => {
            console.log("기본 차트 조회중 에러발생 ", error);
        });
    



    // 선택한 카테고리 차트 조회
    stat.forEach(st => {
        st.addEventListener("click", function () {
            const statType = this.id;
             
            fetch(`${contextPath}/prov/getStatData?statType=${statType}&contractStart=${contractStart}`)
                .then((resp) => {
                    if (!resp.ok) throw new Error("통계 가져오는 중 오류");
                    return resp.json();
                })
                .then((data) => {
                    console.log("응답 데이터 >>> " ,data);
                    drawChart(data, statType);
                    activeCategory(statType);
                })
                .catch((error) => {
                    console.log("에러", error);
                });

        });
    });
});

// 연도 옵션 가져오기 .
function fetchGetYearList(elementId){
    return fetch(`${contextPath}/prov/readOptionYears`)
            .then((resp) => {
                if(!resp.ok) throw new Error("옵션 연도 가져오는중 오류");
                return resp.json();
            })
            .then((data) => {
                console.log("옵션 연도 응답데이터 : " , data);
                allYearList = data.map(year => ({
                    id : year
                  , name : year
                }));
                renderOptions(elementId,allYearList , "");
            })
            .catch((error) => {
                console.log("옵션 연도 가져오는중 오류 발생 >>>" ,error);
            })
}       

// 전년도도 매출 조회 
function totayTotal(){
    const todayPayTotal = document.querySelector("#todaySalesAmount");
    fetch(`${contextPath}/prov/todayTotal`)
        .then((resp) => {
            if(!resp.ok) throw new Error("오늘 매출 조회중 오류");
            return resp.json();
        })
        .then((data) => {
            console.log("오늘 매출 응답 데이터 >>>" , data);
            todayPayTotal.innerText = data.payTotal ? `${Number(data.payTotal).toLocaleString()} 원` : '-';
        })
        .catch((error) => {
            console.log("오늘늘 매출 조회중 오류 >>>", error);
            todayPayTotal.innerText = '-';
          })

}

// 올해 매출 조회 
function yearTotal(){
    const yearPayTotal = document.querySelector("#yearSalesAmount");
    fetch(`${contextPath}/prov/thisYearTotal`)
      .then((resp) => {
        if(!resp.ok) throw new Error("올해 매출 조회중 오류");
        return resp.json();
      })
      .then((data) => {
        console.log("올해 매출 응답 데이터 >>>" , data);
        yearPayTotal.innerText = data.payTotal ? `${Number(data.payTotal).toLocaleString()} 원` : '-';
      })
      .catch((error) => {
        console.log("올해 매출 조회중 오류 >>>", error);
        yearPayTotal.innerText = '-';
      })
}

// ★★★★★옵션 렌더링 함수★★★★★ (필터링을 위한 select 태그에 옵션 추가)
function renderOptions(elementId, optionList, selectedValue) {
    const selectElement = document.querySelector(`#${elementId}`);  // 대상 select 요소 가져오기 ( 부서 , 직급 , 상태 중에서)
    selectElement.innerHTML = '<option value="">전체</option>';  // 기본옵션 "전체" 

    // 옵션 리스트를 순회하면서 select 태그에 추가 
    optionList.forEach(item => {
        selectElement.insertAdjacentHTML("beforeend", `
            <option value="${item.code || item.id}" ${selectedValue === (item.code || item.id) ? 'selected' : ''}>
                ${item.name}
            </option>
        `);
    });
}


// 선택한 카테고리 활성화 
function activeCategory(statType){
    const statItems = document.querySelectorAll('.stat');
    statItems.forEach(item => {
        item.classList.remove("active");
        if(item.id === statType){
            item.classList.add("active");
        }
    });
}

// 차트 그리기 
function drawChart(data, statType) {
    const canvas = document.getElementById('statChart');
    const ctx = canvas.getContext('2d');
    
     // 기존 차트 제거 (destroy)
     if (window.myChart) {
        window.myChart.destroy();
    }

    // 차트 크기 설정 
    if(statType == "contType" || statType == "monthlyCont"){
        canvas.style.width = "900px";
        canvas.style.height = "600px";
        canvas.width = 900;
        canvas.height = 600;
    }else{
        canvas.style.width = "600px";
        canvas.style.height = "600px";
        canvas.width = 600;
        canvas.height = 600;
    }


    // 차트 타입 설정 
    let chartType;
    let labels = [];
    let chartData = [];
    console.log("statType >>> " , statType);
    
    let chartOptions = {
        responsive: false,
        maintainAspectRatio: false,
        scales: {
            y: {
                beginAtZero: true,
                ticks: {
                    stepSize: 1,  // 1씩 증가 (정수만 표시)
                    precision: 0  // 소수점 제거
                }
            }
        },
        // layout: {
        //     padding: {
        //         left: 50,
        //         right: 50,
        //         top: 50,
        //         bottom: 50
        //     }
        // },
        plugins: {
            legend: {
                position: 'top'
            }
            
        }
    };

    switch (statType) {

        case "contType":
            chartType = 'bar';
            data.forEach(item => {
                labels.push(item.CONTRACT_TYPE);
                chartData.push(item.CONTRACT_COUNT);
            });
            break;

        case "monthlyCont":
            chartType = 'line';
            labels = data.map(item => item.MONTH);
            chartData = data.map(item => item.PAY_COUNT);
            break;

        case "contScale":
            chartType = 'doughnut';
            data.forEach(item => {                
                labels.push(item.SCALE_SIZE);
                chartData.push(item.SCALE_COUNT);
                chartOptions = {
                    responsive: false,
                    maintainAspectRatio: false,
                    
                    plugins: {
                        legend: {
                            position: 'top'
                        }
                    }
                };
            })
            break;

        case "contEmpcnt":
            chartType = 'pie';
            data.forEach(item => {
                labels.push(item.EMP_COUNT);
                chartData.push(item.EMP_CNT);
                chartOptions = {
                    responsive: false,
                    maintainAspectRatio: false,
                    
                    plugins: {
                        legend: {
                            position: 'top'
                        }
                    }
                };
            })
            
            break;

        case "contStorage":
            chartType = 'doughnut';
            data.forEach(item => {
                labels.push(item.STORAGE_SIZE);
                chartData.push(item.STORAGE_COUNT);
                chartOptions = {
                    responsive: false,
                    maintainAspectRatio: false,
                    
                    plugins: {
                        legend: {
                            position: 'top'
                        }
                    }
                };
            })
            break;

        default:
            chartType = 'bar';

    }
    console.log("chartType >>>> " , chartType);
    console.log("labels >>>> " , labels);
    console.log("chartData >>>> " , chartData);

 
    let chartTitle = "";
    if(statType == "contType") {
        chartTitle = "업종별 계약";
    }else if(statType == "monthlyCont") {
        chartTitle = "월별 계약";
    }else if(statType == "contScale"){
        chartTitle = "업체 규모별 계약";
    }else if(statType == "contEmpcnt"){
        chartTitle = "사용인원별 계약";
    }else if(statType == "contStorage") {
        chartTitle = "스토리지별 계약";
    }

    window.myChart = new Chart(ctx, {
        
        type: chartType
        , data: {
            labels: labels,
            datasets: [{
                label: `${chartTitle} 통계`,
                data: chartData,
                backgroundColor: [
                    'rgba(75, 192, 192, 0.6)',
                    'rgba(255, 99, 132, 0.6)',
                    'rgba(255, 206, 86, 0.6)',
                    'rgba(54, 162, 235, 0.6)',
                    'rgba(153, 102, 255, 0.6)',
                    'rgba(255, 159, 64, 0.6)'
                ],
                borderWidth: 1
            }]
        },
        options: chartOptions

    });
}












