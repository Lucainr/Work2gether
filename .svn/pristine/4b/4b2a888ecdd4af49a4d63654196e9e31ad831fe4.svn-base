package kr.or.ddit.cloud.controller;

import java.io.IOException;
import java.text.SimpleDateFormat;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

import javax.annotation.PostConstruct;
import javax.servlet.http.HttpSession;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;

import com.amazonaws.services.s3.AmazonS3;
import com.amazonaws.services.s3.model.S3ObjectSummary;

import kr.or.ddit.aws.connection.GetAWSUser;
import kr.or.ddit.aws.object.ReadObjects;
import kr.or.ddit.cloud.service.CloudStorageService;
import kr.or.ddit.cloud.vo.CloudVO;
import kr.or.ddit.employee.vo.EmployeeVO;

@Controller
@RequestMapping("/{companyId}/pubCloud")
public class PublicCloudStorageController {
	private GetAWSUser awsUser;
	private ReadObjects readObjects;
	
	@Autowired
	private CloudStorageService service;
	
	@PostConstruct
	public void init() throws IOException {
		this.awsUser = new GetAWSUser();
		this.readObjects = new ReadObjects();
	}
	
	@GetMapping
	public String getPublicCloudStorage(
		HttpSession session,
		Model model
		) {
		EmployeeVO emp = (EmployeeVO) session.getAttribute("myEmp");
		String empId = emp.getEmpId();
		CloudVO cloud = service.readCloudInfo(empId);
		
		AmazonS3 s3 = awsUser.getAWSUser(cloud.getProvAccesskey(), cloud.getProvSecretkey());
		List<S3ObjectSummary> objList = readObjects.getObjects(s3, cloud.getContractBucket(), cloud.getPubCloudPath());
		
		
		   // 파일과 폴더 분리
	    List<Map<String, String>> files = new ArrayList<>();
	    List<Map<String, String>> folders = new ArrayList<>();
	    SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss");
	    
	    for (S3ObjectSummary obj : objList) {
	        String key = obj.getKey();
	        Map<String, String> data = new HashMap<>();
	        if (key.endsWith("/")) {
	            // 폴더 이름만 추출
	            String folderName = key.substring(0, key.length() - 1);
	            folderName = folderName.substring(folderName.lastIndexOf("/") + 1);
	            data.put("name", folderName);
	            data.put("type", "Folder");
	            data.put("size", "-");
	            data.put("lastModified", "-");
	            folders.add(data);
	        } else {
	            // 파일 이름만 추출
	            String fileName = key.substring(key.lastIndexOf("/") + 1);
	            data.put("name", fileName);
	            data.put("type", "File");
	            data.put("size", formatFileSize(obj.getSize()));
	            data.put("lastModified", sdf.format(obj.getLastModified()));
	            files.add(data);
	        }
	    }
	    
	    model.addAttribute("folders", folders);
	    model.addAttribute("files", files);
	    
		return "cloud/publicStorage";
	}
	
	// 파일 크기를 사람이 읽기 쉬운 형식으로 변환
	private String formatFileSize(long size) {
	    if (size < 1024) {
	        return size + " Bytes";
	    } else if (size < 1024 * 1024) {
	        return String.format("%.2f KB", size / 1024.0);
	    } else if (size < 1024 * 1024 * 1024) {
	        return String.format("%.2f MB", size / (1024.0 * 1024));
	    } else {
	        return String.format("%.2f GB", size / (1024.0 * 1024 * 1024));
	    }
	}
	
}
