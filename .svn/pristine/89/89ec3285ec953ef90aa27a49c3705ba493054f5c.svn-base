function toKoreaTimeISOString(date) {
	const offset = 9 * 60 * 60000; // UTC+9 한국 시간대 오프셋 (ms 단위)
	const koreaTime = new Date(date.getTime() + offset);
	return koreaTime.toISOString().slice(0, 16);
}


document.addEventListener("DOMContentLoaded", function() {
	const companyId = document.querySelector("#hiddenCompanyId").value;
	const empId = document.querySelector("#hiddenEmpId").value;
	const rastId = document.querySelector("#hiddenRastEmpId").value;
	const calendarEl = document.querySelector("#calendar");
	const mySchStart = document.querySelector("#schStart");
	const mySchEnd = document.querySelector("#schEnd");
	const mySchTitle = document.querySelector("#eventName");
	const mySchContent = document.querySelector("#eventContent");
	const mySchAllday = document.querySelector("#allDay");
	const mySchBColor = document.querySelector("#schBColor");
	const mySchFColor = document.querySelector("#schFColor");

	// 수정 버튼 생성
	const modifyEventBtn = document.createElement("button"); 
	modifyEventBtn.id = "modifyEventBtn";
	modifyEventBtn.className = "btn btn-success";
	modifyEventBtn.textContent = "수정";
	modifyEventBtn.style.display = "none";
	
	// 삭제 버튼 생성
    const deleteEventBtn = document.createElement("button");
    deleteEventBtn.id = "deleteEventBtn";
    deleteEventBtn.className = "btn btn-danger";
    deleteEventBtn.textContent = "삭제";
    deleteEventBtn.style.display = "none";
	
	

	  //캘린더 헤더 옵션
        const headerToolbar = {
            left: 'prevYear,prev,next,nextYear today',
            center: 'title',
            right: 'dayGridMonth,dayGridWeek,timeGridDay'
        }


	// FullCalendar 초기화
	const calendar = new FullCalendar.Calendar(calendarEl, {
		height: "700px",
		expandRows: true, // 화면에 맞게 높이 재설정
		initialView: "dayGridMonth",
		slotMinTime: '09:00', // Day 캘린더 시작 시간
		slotMaxTime: '18:00', // Day 캘린더 종료 시간
		locale: "kr",
		headerToolbar: headerToolbar,
		editable: true,
		selectable: true,    // 영역 선택
		selectMirror: true,  // 오직 TimeGrid view에만 적용됨, default false
		navLinks: true,      // 날짜,WeekNumber 클릭 여부, default false
		weekNumbers: true,   // WeekNumber 출력여부, default false
		dayMaxEventRows: true,
		eventSources: [
			{
        		url: `../schedule`, // 서버의 GET API URL
		        method: "GET",
		        failure: function() {
		            console.error("서버에서 데이터를 불러오지 못했습니다.");
		            alert("일정 데이터를 불러오는 데 실패했습니다.");
		        },
		        success: function(events) {
		            console.log("서버에서 불러온 데이터:", events);
		        }
		    }
		]
	});

	
	// 캘린더 그리깅
	calendar.render();


	const modalFooter = document.querySelector(".modal-footer");
	modalFooter.appendChild(modifyEventBtn);
	modalFooter.appendChild(deleteEventBtn);

	function resetModalFields() {
		mySchTitle.value = "";
		mySchContent.value = "";
		mySchStart.value = "";
		mySchEnd.value = "";
		mySchAllday.checked = false;
		mySchBColor.value = "#000000";
		mySchFColor.value = "#FFFFFF";
	}

	// 모달 열기 전에 초기화
	calendar.on("select", (info) => {
	    resetModalFields(); // 입력 필드 초기화
	    const now = new Date();
	    const start = new Date(info.start);
	    start.setHours(now.getHours(), now.getMinutes(), 0);
	
	    const end = new Date(info.end);
	    end.setHours(0, 0, 0);
	
	    mySchStart.value = toKoreaTimeISOString(start); // 한국 시간 적용
	    mySchEnd.value = toKoreaTimeISOString(end);
	
	    addEventBtn.style.display = "inline-block";
	    modifyEventBtn.style.display = "none";
	    deleteEventBtn.style.display = "none";
	
	    const modal = new bootstrap.Modal(document.getElementById("basicModal"));
	    modal.show();
	});


	//등록 이벤트를 하는 부분
	document.getElementById("addEventBtn").addEventListener("click", () => {
		if (!mySchTitle.value) {
			alert("제목을 입력해주세요.");
			mySchTitle.focus();
			return;
		}
		
		// 날짜 포맷을 ISO 8601 형식으로 변환
    	const formatDate = (date) => {
		    const d = new Date(date);
		    const year = d.getFullYear();
		    const month = String(d.getMonth() + 1).padStart(2, "0");
		    const day = String(d.getDate()).padStart(2, "0");
		    const hours = String(d.getHours()).padStart(2, "0");
		    const minutes = String(d.getMinutes()).padStart(2, "0");
		    return `${year}-${month}-${day}T${hours}:${minutes}`; // 초 단위 제거
		};

		const event = {
			scheTitle: mySchTitle.value,  // 제목
			scheContent: mySchContent.value, // 상세 내용
			scheSdate: formatDate(mySchStart.value),  // 시작일 (ISO 형식)
        	scheEdate: formatDate(mySchEnd.value),    // 종료일 (ISO 형식)
			scheLastup: empId, // 예시
			empId: empId,                 // 직원 ID
			scheBcolor: mySchBColor.value || "#000000", // 배경색
			scheFcolor: mySchFColor.value || "#FFFFFF"  // 글자색
		};
		console.log(event)
		
		fetch(`../schedule/add`, {
			method: "POST",
			headers: {
				"Content-Type": "application/json",
			},
			body: JSON.stringify(event),
		})
			.then((response) => {
				if (!response.ok) {
					throw new Error("서버 요청 실패");
				}
				return response.json();
			})
			.then((data) => {
				console.log("서버로부터 응답:", data);

				const calendarEvent = {
					id: data.scheId, // 서버에서 반환한 scheId
					title: event.scheTitle,
					start: event.scheSdate,
					end: event.scheEdate,
					backgroundColor: event.scheBcolor,
					textColor: event.scheFcolor,
					extendedProps: {
            			scheContent: event.scheContent // 상세 내용 추가
        			}
				};

				// 캘린더에 이벤트 추가
		        calendar.addEvent(calendarEvent);
		
		        const modal = bootstrap.Modal.getInstance(document.getElementById("basicModal"));
		        modal.hide();
		        resetModalFields();
			})
			.catch((error) => {
				console.error("Error:", error);
				alert("일정 저장에 실패했습니다. 다시 시도해주세요.");
			});
	});
	
	let currentScheId = null; // 현재 선택된 이벤트 ID 저장 변수
	
	//내가 등록된 일정을 눌렀을때~
	calendar.on("eventClick", (info) => {
		const event = info.event; // 클릭한 이벤트 객체
    	currentScheId = event.id;  // 이벤트 ID (scheId)
		
		
		
		// 기존 이벤트 데이터를 모달에 채워 넣음
		mySchStart.value = event.start.toISOString().slice(0, 16); // 시작일
		mySchEnd.value = event.end ? event.end.toISOString().slice(0, 16) : ""; // 종료일
		mySchTitle.value = event.title; // 제목
		mySchContent.value = event.extendedProps.scheContent || ""; // 상세 내용
		mySchAllday.checked = event.allDay; // 종일 여부
		mySchBColor.value = event.backgroundColor || "#000000"; // 배경색
		mySchFColor.value = event.textColor || "#FFFFFF"; // 글자색

		addEventBtn.style.display = "none"; // 추가 버튼 숨기기
		modifyEventBtn.style.display = "inline-block"; // 수정 버튼 보이기
 		deleteEventBtn.style.display = "inline-block"; // 삭제 버튼 보이기
		
		// 수정 버튼 클릭 시 서버로 수정된 데이터를 전송
		modifyEventBtn.onclick = () => {
			const updatedEvent = {
				scheId: event.id,  // 일정번호
				scheSdate: mySchStart.value,  // 시작일
				scheEdate: mySchEnd.value,    // 종료일
				scheTitle: mySchTitle.value,  // 제목
				scheContent: mySchContent.value, // 상세 내용
				scheLastup: empId,            // 수정자 ID
				empId: event.extendedProps.empId, // 직원 ID (기존 값 유지)
				scheBcolor: mySchBColor.value, // 배경색
				scheFcolor: mySchFColor.value  // 글자색
			};

			// 서버로 수정 요청
			fetch(`../schedule/${event.id}/edit`, { // 수정 요청 URL
				method: "PUT", // HTTP PUT 요청
				headers: {
					"Content-Type": "application/json"
				},
				body: JSON.stringify(updatedEvent)
			})
				.then((response) => {
					if (!response.ok) {
						throw new Error("서버 요청 실패");
					}
					return response.json();
				})
				.then((data) => {
					console.log("서버 응답:", data);

					// FullCalendar 이벤트 객체 업데이트
					event.setStart(updatedEvent.scheSdate);
					event.setEnd(updatedEvent.scheEdate);
					event.setProp("title", updatedEvent.scheTitle);
					event.setExtendedProp("scheContent", updatedEvent.scheContent);
					event.setProp("backgroundColor", updatedEvent.scheBcolor);
					event.setProp("textColor", updatedEvent.scheFcolor);

					alert("이벤트가 성공적으로 수정되었습니다.");
				})
				.catch((error) => {
					console.error("Error:", error);

					alert("이벤트 수정에 실패했습니다.");
				});

			// 모달 닫기
			const modal = bootstrap.Modal.getInstance(document.getElementById("basicModal"));
			modal.hide();
		};
		
		
		deleteEventBtn.onclick = () => {
			    if (!confirm("정말로 이 이벤트를 삭제하시겠습니까?")) return;
			
			    const modal = bootstrap.Modal.getInstance(document.getElementById("basicModal"));
			    modal.hide();
			
			    deleteEventBtn.disabled = true; // 버튼 비활성화
			    deleteEventBtn.textContent = "삭제 중..."; // 로딩 메시지 표시
			
			    // 비동기 AJAX 요청
			    $.ajax({
			        url: `../schedule/${currentScheId}/delete`, // 서버 API URL
			        type: "DELETE", // HTTP 메서드
			        dataType: "text", // 서버 응답 타입
			        async: true, // 비동기 설정 (기본값 true)
			        success: function (result) {
			            if (result === "success") {
			                info.event.remove(); // FullCalendar에서 이벤트 제거
			                alert("이벤트가 성공적으로 삭제되었습니다.");
			            } else {
			                alert("이벤트 삭제에 실패했습니다.");
			            }
			        },
			        error: function (xhr, status, error) {
			            console.error("삭제 요청 실패:", error);
			            alert("서버와의 통신 오류로 삭제에 실패했습니다.");
			        },
			        complete: function () {
			            // 삭제 완료 후 버튼 상태 복원
			            deleteEventBtn.disabled = false;
			            deleteEventBtn.textContent = "삭제";
			        },
			    });
			};




		// 모달 열기
		const modal = new bootstrap.Modal(document.getElementById("basicModal"));
		modal.show();
	});

});