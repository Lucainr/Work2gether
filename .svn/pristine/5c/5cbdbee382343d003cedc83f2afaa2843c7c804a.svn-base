const ApprovalCommon = {

    elements: {},//공통 요소들을 저장할 객체

    //초기화 함수 정하기
    initialize: function () {
        //요소들 초기화
        this.elements = {
            // 요소들 나열하기
            vacationFormContainer: document.getElementById('vacationFormContainer'),
            previewContainer: document.getElementById('previewContainer'),
            modifyBtn: document.getElementById('modifyBtn'),
            nextBtn: document.getElementById('nextBtn'),
            buttonGroup: document.querySelector('.button-group'),
            orgTree: document.getElementById('orgTree'),
            saveApprovalLineBtn: document.getElementById('saveApprovalLine'),
            formSelect: document.getElementById('formSelect'),
            allowFinalApprovalCheckbox: document.getElementById('allowFinalApprovalCheckbox'),
            allowFinalApprovalHidden: document.getElementById('allowFinalApprovalHidden')
        };

        if (!this.elements.previewContainer) {
            console.error('previewContainer element not found');
        }

        this.setEventListeners();
    },

    setEventListeners: function () {
        // 트리 노드 클릭 이벤트
        this.elements.orgTree.addEventListener('click', (e) => {
            const span = e.target.closest('span');
            if (!span) return;

            //폴더 클릭시 토글되는것
            const li = span.closest('li');
            if (li.classList.contains('folder')) {
                li.classList.toggle('open');
                return; // 폴더 클릭시에 여기서 종료함
            }

            // 사원 선택인 경우
            if (span.hasAttribute('data-emp-id')) {

                const employeeLi = span.closest('li');
                const departmentLi = employeeLi.closest('li.folder');
                const departmentName = departmentLi ? departmentLi.querySelector('span')
                    .textContent : '부서없음';

                const employeeInfo = {
                    empId: span.getAttribute('data-emp-id'),
                    departmentName: departmentName,
                    name: span.textContent.replace(/\([^)]*\)/g, '').trim(), //괄호 안 내용 제거하기(부서장)
                    position: span.textContent.split(' ')[0]//직위는 이름 앞에 있음
                };

                console.log("Selected employee:", employeeInfo);

                //본인 선택을 방지하기
                if (employeeInfo.empId === myEmpId) { //myEmpId는 JSP에서 세션값으로 갖고온다
                    alert('본인은 결재자로 지정할 수 없다~~');
                    return;
                }

                //중복 선택 방지
                const existingApprovers = document.querySelectorAll('#approverList tr');
                for (let approver of existingApprovers) {
                    if (approver.getAttribute('data-emp-id') === employeeInfo.empId) {
                        alert('이미 추가된 결재자입니다');
                        return;
                    }
                }

                this.addApprover(employeeInfo);
            }
        });

        // 결재선을 저장하는 버튼을 클릭했을때의 이벤트
        this.elements.saveApprovalLineBtn.addEventListener('click', async () => {
            const approvers = this.collectApprovers();
            if (approvers.length === 0) {
                alert('최소 한 명 이상의 결재자를 지정해주세요');
                return;
            }

            try {
                await this.saveApprovalLine(approvers);
                //모달 닫기
                const modal = bootstrap.Modal.getInstance(document.getElementById('approvalLineModal'));
                modal.hide();
            } catch (error){
                console.error('결재선 저장 중 오류 : ', error);
                alert('결재선 저장 중 오류가 발생한듯~~!');
            }
        });


        // formSelect 이벤트 리스너 추가
        this.elements.formSelect.addEventListener('change', function(e) {
            const selectedValue = e.target.value;
            if (selectedValue === 'v01') {  // 휴가신청서 선택 시
                ApprovalVacation.initialize();  // 휴가 양식 초기화
            }
        });

        // 수정 버튼 클릭 시
        this.elements.modifyBtn.addEventListener('click', () => {
            this.elements.previewContainer.style.display = 'none';
            this.elements.buttonGroup.style.display = 'none';
            this.elements.vacationFormContainer.style.display = 'block';
        });

        // 다음 버튼 클릭 시 (결재선 지정 페이지로 이동)
        this.elements.nextBtn.addEventListener('click', function () {
            alert("아직 미구현임");
        });

        // 전결 허용 여부 체크박스 이벤트
        this.elements.allowFinalApprovalCheckbox.addEventListener('change', () => {
            this.elements.allowFinalApprovalHidden.value =
                this.elements.allowFinalApprovalCheckbox.checked ? 'Y' : 'N';
        });
    },

    //결재자 정보를 수집하기 비동기로 보내야하니까
    collectApprovers: function () {
        const approvers = [];
        const rows = document.querySelectorAll('#approverList tr');

        rows.forEach((row, index) => {
            const approver= ({
                empId: row.getAttribute('data-emp-id'),
                order: index + 1,
                departmentName: row.children[1].textContent,
                position: row.children[2].textContent.split(' ')[0],
                name: row.children[2].textContent.split(' ')[1]
            });
            console.log('Collected approver:', approver);  // 각 결재자 정보 확인
            approvers.push(approver);
        });

        return approvers;
    },

    //결재선 추가시켜서 html문서 다시 렌더링해서 갖고오기
    saveApprovalLine: async function(approvers){
        try {
            // 현재 미리보기 문서 HTML 가져오기
            const previewContainer = document.getElementById('previewContainer');
            console.log('Preview container : ', previewContainer)

            if (!previewContainer) { throw new Error('미리보기 컨테이너를 찾을 수 없습니다~')}

            const currentDocument = previewContainer.innerHTML;
            const formData = {
                documentHtml: currentDocument,
                approvers: approvers
            };

            const resp = await fetch(appendApproversUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(formData)
            });

            const respText = await resp.text();


            console.log(`받아온 데이터`, respText);

            if (!resp.ok) {
                throw new Error(`서버 오류: ${respText}`);
            }

            previewContainer.innerHTML = respText;
            this.showPreview();
        } catch(error) {
            console.error('결재선 저장 중 오류난듯??', error);
            throw error;
        }
    },

    //조직도 관련된거
    // 조직도 데이터와 사원 데이터를 함께 로드 - 어차피 둘중에 하나라도 못불러오면 망하는거니까
    loadOrgTreeWithEmployees: async function () {
        try {
            //병렬로 데이터를 그냥 같이 로딩해버리자
            const [orgResp, empResp] = await Promise.all([
                fetch(orgTreeUrl),
                fetch(empUrl)
            ]);
            //둘다 제이슨으로 받을때까지 기다리기
            const [orgData, empData] = await Promise.all([
                orgResp.json(),
                empResp.json()
            ]);

            //부서별 사원 맵 생성
            const employeeByDept = {};
            empData.forEach(emp => {
                // 디버깅 로그 추가
                console.log("처리중인 사원:", emp);

                if (!employeeByDept[emp.departCode]) {
                    employeeByDept[emp.departCode] = []; //없으면 빈 배열을 생성하겠다는 뜻임
                }
                employeeByDept[emp.departCode].push(emp); // 내번호에 내거집어넣겠다는뜻임
            });
            // 최종 맵 확인
            console.log("부서별 사원 맵:", employeeByDept);

            //트리 데이터 구성 할 때 사원 정보도 포함 시키기
            const treeData = this.buildTreeDataWithEmployees(orgData, employeeByDept);

            //트리 HTML 생성 및 삽입
            const treeHtml = this.renderTreeWithEmployees(treeData);
            document.getElementById('orgTree').innerHTML = treeHtml;
        } catch (error) {
            console.error('데이터 로딩 중 에러 발생했네!! : ', error);
        }
    },

    //조직도 디렉토리 빌드
    buildTreeDataWithEmployees: function (departments, employeesByDept) {
        const tree = [];
        const map = {};

        // 부서상태가 Y인 활성화 부서 상태만 갖고와야함 이거 검증안했다가 오류났음
        const activeDepts = departments.filter(dept => dept.departStatus === 'Y');

        // 부서 노드를 생성한다음에 거기에 사원정보를 추가한다
        activeDepts.forEach(dept => {
            //map 객체의 역할 : departCode를 키로 사용하여, 부서 데이터와 관련된 정보를 저장.

            // 예: map['D001'] = { departCode: 'D001', departName: '개발1팀', ... }
            map[dept.departCode] = {
                // ...dept는 스프레드 연산자로, 기존 부서 객체의 모든 속성을 복사한다
                ...dept,
                children: [],
                employees: employeesByDept[dept.departCode] || []
            };
            //map[dept.departCode] = { ... } 이 부분에서 기존 데이터가 복사되어 덮어씌워지는 구조.
            // <- 오른쪽에서 왼쪽으로 가잖아
        });

        //부모 자식관계 만들기
        activeDepts.forEach(dept => {
            //부모가 있고, 그 부모가 map에 존재하는 경우에만 처리 이거안했다가 오류났음
            if (dept.departParentcode && map[dept.departParentcode]) { // 부모 부서가있다면?
                // 부모가 있으면 부모부서의 children 배열에 현재 부서 추가하기
                map[dept.departParentcode].children.push(map[dept.departCode]);
            } else if (!dept.departParentcode) {
                // 부모가없거나 부모가 map에 없는 경우 최상위 노드로 처리해버리자
                tree.push(map[dept.departCode]);
            }
        });
        console.log('생성된 트리 구조:', tree);  // 디버깅용
        return tree;
    },

    //조직도 트리 렌더링하는 함수
    renderTreeWithEmployees: function (node) {
        if (!Array.isArray(node) || node.length === 0) return '';

        //시작
        let html = '<ul>';
        node.forEach(item => {
            if (!item) return;

            //실제 렌더링시킬 데이터들 html에 추가하기
            html += `<li class="folder">`;

            //부서 정보
            html += `<span data-code="${item.departCode}" data-head="${item.departHead || ''}">${item.departName}</span>`;

            //사원 목록
            if (item.employees && item.employees.length > 0) {
                html += '<ul class="employees">';

                //부서장을 먼저 표시하기 (클라이언트단에서해버리자)
                const head = item.employees.find(emp => emp.empId === item.departHead);
                if (head) {
                    html += `<li class="department-head">
                        <span data-emp-id="${head.empId}">
                            ${head.posiName} ${head.empName} (부서장)
                        </span>
                    </li>`
                }

                //나머지 사원들을 표시하기 얘네들은 일반사원임
                item.employees
                    .filter(emp => emp.empId !== item.departHead)
                    .forEach(emp => {
                        html += `<li class="employee">
                            <span data-emp-id="${emp.empId}">
                                ${emp.posiName} ${emp.empName}
                            </span>
                        </li>`;
                    });
                html += '</ul>';
            }

            // 하위 부서가 있으면 재귀적으로 렌더링
            if (Array.isArray(item.children) && item.children.length > 0) {
                //this를 안 붙였을 때는 전역 스코프(global scope)에서 해당 함수를 찾으려고 시도한다
                /**
                 * 먼저 전역 스코프(window 객체)에서 renderTreeWithEmployees 함수를 검색
                 * 전역 스코프에는 이 함수가 정의되어 있지 않기 때문에
                 * ReferenceError: renderTreeWithEmployees is not defined 에러가 발생
                 *
                 * 반면 this를 붙힌다면
                 * this(ApprovalCommon 객체)의 속성으로 정의된 메서드를 검색
                 * ApprovalCommon 객체 내에 해당 메서드가 존재하므로 정상적으로 메서드가 호출
                 */
                html += this.renderTreeWithEmployees(item.children);
            }
            html += `</li>`;
        });
        html += '</ul>';
        return html;

    },
    // 결재자 추가 함수
    addApprover: function (emp) {
        const tbody = document.getElementById('approverList');
        //결재자 정보 저장을 위한 데이터 속성 추가하기
        const row = document.createElement('tr');
        row.setAttribute('data-emp-id', emp.empId);

        row.innerHTML = `
            <td>${tbody.children.length + 1}</td>
            <td>${emp.departmentName}</td>
            <td>${emp.position} ${emp.name}</td>
            <td>
                <div class="btn-group" role="group">
                    <!-- 맨위에 결재자가 올라가면 위 화살표는 보이지 않아야한다 -->
                    <button type="button" class="btn btn-sm btn-outline-secondary up-btn" 
                            ${tbody.children.length === 0 ? 'style="display:none"' : ''}>
                        ↑
                    </button>
                    <!-- 맨 아래의 경우도 마찬가지 -->
                    <button type="button" class="btn btn-sm btn-outline-secondary down-btn">
                        ↓
                    </button>
                    <button type="button" class="btn btn-sm btn-danger delete-btn">삭제</button>
                </div>
            </td>
        `;

        //행클릭 이벤트
        row.addEventListener('click', (e) => {
            // 버튼 클릭은 제외한다
            if (!e.target.closest('button')) {
                //기존의 선택된 행의 스타일 제거한다
                document.querySelectorAll('#approverList tr.selected').forEach(tr => {
                    tr.classList.remove('selected');
                });
                //현재 행의 스타일 추가하기
                row.classList.add('selected');
            }
        });

        //위로 이동하는 버튼 이벤트
        row.querySelector('.up-btn').addEventListener('click', () => {
            const prevRow = row.previousElementSibling;
            if (prevRow) {
                tbody.insertBefore(row, prevRow);
                this.updateMoveButtons();
                this.reorderApprovers();
            }
        });

        //아래로 이동하는 버튼 이벤트
        row.querySelector('.down-btn').addEventListener('click', () => {
            const nextRow = row.nextElementSibling;
            if (nextRow) {
                tbody.insertBefore(nextRow, row);
                this.updateMoveButtons();
                this.reorderApprovers();
            }
        })

        //삭제 버튼 이벤트 추가
        row.querySelector('.delete-btn').addEventListener('click', () => {
            row.remove();
            this.updateMoveButtons();
            this.reorderApprovers(); //순서 재정렬하기
        });

        tbody.appendChild(row);
        this.updateMoveButtons();

    },

    //이동 버튼 상태 업데이트 함수
    updateMoveButtons: function () {
        const rows = document.querySelectorAll('#approverList tr');
        rows.forEach((row, index) => {
            const upBtn = row.querySelector('.up-btn');
            const downBtn = row.querySelector('.down-btn');

            // 첫번째 행
            if (index === 0) {
                upBtn.style.display = 'none';
            } else {
                upBtn.style.display = 'inline-block';
            }

            // 마지막 행
            if (index === rows.length - 1) {
                downBtn.style.display = 'none';
            } else {
                downBtn.style.display = 'inline-block';
            }
        });
    },

    // 결재자 순서 재정렬 함수
    reorderApprovers: function () {
        const rows = document.querySelectorAll('#approverList tr');
        rows.forEach((row, index) => {
            row.querySelector('td:first-child').textContent = index + 1;
        });
    },

    // 문서 미리보기 공통 처리
    handlePreview: async function (formData, formId) {
        //여기서 뭘받을지정해져버림 v01이면 이제 컨트롤러에서 휴가 문서 템플릿을꺼내오든지할거임
        const finalPreviewUrl = preViewTypeUrl.replace('{formId}', formId);

        const resp = await fetch(finalPreviewUrl, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(formData)
        });

        if (!resp.ok) throw new Error(`HTTP 에러인듯~~ status : ${resp.status}`);

        // 밑에거안되면 바로삭제하고 이거쓰기
        const html = await resp.text();
        approvalElements.previewContainer.innerHTML = html;
        this.showPreview();
    },

    // 문서와 버튼 표시
    showPreview: function () {
        this.elements.previewContainer.style.display = 'block';
        this.elements.vacationFormContainer.style.display = 'none';
        this.elements.buttonGroup.classList.add('show');
    }

    // 저장 버튼 이벤트 리스터
};


