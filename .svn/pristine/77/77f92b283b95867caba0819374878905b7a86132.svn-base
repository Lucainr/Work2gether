<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper
	namespace="kr.or.ddit.schedule.dao.ScheduleMapper">
	
	<resultMap type="ScheduleVO" id="scheduleList">
		<association property="code" javaType="CommonCodeVO"></association>
	</resultMap>
		<!-- <select id="selectScheduleList" resultMap="scheduleList">
	
		SELECT 
				S.SCHE_ID
				,S.SCHE_TITLE
				,S.SCHE_CONTENT
				,S.SCHE_SDATE
				,S.SCHE_EDATE
				, CASE
		            WHEN #{scheEdate,jdbcType=DATE} &lt; SYSDATE THEN '완료'
					WHEN #{scheSdate,jdbcType=DATE} &gt; SYSDATE THEN '진행 예정'
					WHEN #{scheSdate,jdbcType=DATE} &lt;= SYSDATE THEN '진행중'
		            ELSE SCHE_STATUS
		        END AS SCHE_STATUS
				,S.SCHE_REGIDATE
				,S.SCHE_LASTUP
				,S.SCHETYPE_ID
				,S.EMP_ID
				,S.SCHE_BCOLOR
				,S.SCHE_FCOLOR
				,C.CODE_COMMENT
				FROM SCHEDULE S
				INNER JOIN COMMON_CODE C 
			    	ON S.SCHETYPE_ID = C.CODE
				WHERE C.TABLE_NAME = 'SCHEDULE'
				  AND C.CODE= #{code}
	</select> -->
	<select id="selectScheduleList" resultType="ScheduleVO">
	
		SELECT 
			SCHE_ID
			,SCHE_TITLE
			,SCHE_CONTENT
			,SCHE_SDATE
			,SCHE_EDATE
			,SCHE_REGIDATE
			,SCHE_LASTUP
			,EMP_ID
			,SCHE_BCOLOR
        	,SCHE_FCOLOR
		FROM SCHEDULE
				
				
	</select>
	<select id="selectScheduleOne">
	SELECT 
			SCHE_ID
			,SCHE_TITLE
			,SCHE_CONTENT
			,SCHE_SDATE
			,SCHE_EDATE
			,SCHE_REGIDATE
			,SCHE_LASTUP
			,SCHETYPE_ID
			,EMP_ID
			,SCHE_BCOLOR
        	,SCHE_FCOLOR
		FROM SCHEDULE
		WHRER SCHE_ID = #{scheId} <!-- AND SCHETYPE_ID =#{schetypeId} -->
	
	</select>
	
	
	
	
	
	<insert id="insertSchedule">
		INSERT INTO SCHEDULE(
			SCHE_TITLE
			,SCHE_CONTENT
			,SCHE_SDATE
			,SCHE_EDATE
			,SCHE_LASTUP
			,EMP_ID
			,SCHE_BCOLOR
        	,SCHE_FCOLOR
		)VALUES(
			
		#{scheTitle,jdbcType=VARCHAR}
		, #{scheContent,jdbcType=VARCHAR}
		, #{scheSdate,jdbcType=DATE}
		, #{scheEdate,jdbcType=DATE}
		, #{scheLastup,jdbcType=VARCHAR}
		, #{empId,jdbcType=VARCHAR}
		,#{scheBcolor,jdbcType=VARCHAR}
        ,#{scheFcolor,jdbcType=VARCHAR}  	
		)
		
	</insert>
	
	<update id="updateSchedule">
	 UPDATE SCHEDULE
	SET
		SCHE_TITLE=#{scheTitle,jdbcType=VARCHAR},
		SCHE_CONTENT=#{scheContent,jdbcType=VARCHAR},
		SCHE_SDATE=#{scheSdate,jdbcType=DATE},
		SCHE_EDATE=#{scheEdate,jdbcType=DATE},
		SCHE_STATUS = CASE
			WHEN #{scheSdate,jdbcType=DATE} &gt; SYSDATE THEN '진행 예정'
			WHEN #{scheSdate,jdbcType=DATE} &lt;= SYSDATE THEN '진행중'
			ELSE SCHE_STATUS
		END,
		SCHE_REGIDATE = SYSDATE,
		SCHE_LASTUP=#{scheLastup,jdbcType=VARCHAR},
		SCHE_BCOLOR=#{scheBcolor,jdbcType=VARCHAR},
        SCHE_FCOLOR=#{scheFcolor,jdbcType=VARCHAR} 
	WHERE SCHE_ID = #{scheId} <!-- AND SCHETYPE_ID = #{schetypeId} -->
	
	</update>
	
	
	<delete id="deleteSchedule">
	DELETE FROM SCHEDULE
	WHERE SCHE_ID = #{scheId}
	</delete>
	
</mapper>