<%@ page language="java" contentType="text/html; charset=UTF-8"
         pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>
<%@ taglib prefix="security" uri="http://www.springframework.org/security/tags" %>
<h3 id"page-title">공지사항 게시판 리스트</h3>
<table class="table table-bordered">
    <thead>
    <tr>
        <th>번호</th>
        <th>제목</th>
        <th>작성자</th>
        <th>작성일</th>
    </tr>
    </thead>
    <tbody>
    <c:choose>
        <c:when test="${not empty noticeList}">
            <c:forEach items="${noticeList}" var="notice">
                <tr>
                    <td>${notice.noticeNo}</td>
                    <td>
                        <c:url value="/${companyId}/notice/${notice.noticeNo}" var="detailUrl" />
                        <!-- 중요 공지 여부에 따른 강조 처리 -->
                        <a href="${detailUrl}" class="notice-link">
                            <c:choose>
                                <c:when test="${notice.noticeImportant eq 'Y'}">
                                    <!-- 중요 공지: 당구장 특수문자 + 스트롱 태그 -->
                                    <strong>※ ${notice.noticeName} </strong>
                                </c:when>
                                <c:otherwise>
                                    <!-- 일반 공지 -->
                                    ${notice.noticeName}
                                </c:otherwise>
                            </c:choose>
                        </a>
                    </td>
                    <td>${notice.employee.empName}</td>
                    <td>${notice.noticeDate}</td>
                </tr>
            </c:forEach>
        </c:when>
        <c:otherwise>
            <tr>
                <td colspan="4">등록된 공지사항이 없습니다.</td>
            </tr>
        </c:otherwise>
    </c:choose>
    </tbody>
</table>


<!-- 글쓰기 버튼 -->
<security:authorize access="isAuthenticated()">
    <security:authentication property="principal" var="principal" />
    <c:if test="${principal.account.posiId == '7'}">
        <div class="text-right mt-3">
            <c:url value="/${companyId}/notice/newForm" var="writeUrl" />
            <a href="${writeUrl}" class="btn btn-primary">글쓰기</a>
        </div>
    </c:if>
</security:authorize>

<%--<!-- 글쓰기 버튼 테스트용 -->--%>
<%--<div class="text-right mt-3">--%>
<%--    <c:url value="/${companyId}/notice/new" var="writeUrl" />--%>
<%--    <a href="${writeUrl}" class="btn btn-primary">글쓰기</a>--%>
<%--</div>--%>


<!-- 페이지네이션 -->
<div class="paging-area">
    ${pagingHTML}
</div>
