@charset "UTF-8";

#nowcount{
	color: red;
}

th{
	text-align: center;
}

td{
	text-align: center;
}


#searchArea {
    display: flex;
    gap: 10px;
    align-items: center;
    justify-content: flex-end;
    padding-top: 10px;
    padding-bottom: 10px;
}

#reload-btn {
    margin-right: 280px !important; /* !important를 사용해 인라인 스타일보다 우선 적용 */
}

#searchDateForm {
    display: flex;
    align-items: center;
    gap: 10px;
}

.form-control {
    width: auto; /* input 필드의 너비 조정 */
}

#vacationStatusTable{
	border: 1px solid gray;
}

.paging-area {
    display: flex;
    justify-content: space-between;
    align-items: center; /* 상하 정렬 */
    margin-top: 0; /* 불필요한 여백 제거 */
}