/* 문서 미리보기 영역 */
.preview-container {
    padding: 20px;
}

/* 결재선 관련 스타일 */
#approval-line-container {
    position: absolute;
    top: 0;
    right: 20px;
    text-align: left;
    margin-top: 1cm;
}

#approver-list {
    display: flex;
    gap: 5px;
    justify-content: flex-end;
    list-style: none;
    padding: 0;
    margin: 0;
}

.approver-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 80px;
    border: 1px solid #000000;
    padding: 5px;
    border-radius: 4px;
    background-color: #fff;
}

.stamp-box {
    width: 60px;
    height: 60px;
    border: 1px solid #000000;
    margin-bottom: 3px;
    background-color: #fff;
}

.approver-info {
    font-size: 12px;
    text-align: center;
    word-break: keep-all;
    width: 100%;
}

/* 조직도 트리 스타일 */
.org-tree {
    border: 1px solid #ddd;
    padding: 15px;
    max-height: 400px;
    overflow-y: auto;
}

.org-tree > ul {  /* 최상위 ul */
    list-style: none;
    padding-left: 0;
    margin: 0;
}

.org-tree ul ul {  /* 하위 ul들 */
    list-style: none;
    padding-left: 20px;
}

.org-tree li {
    padding: 3px 0;
    cursor: pointer;
}

/* 폴더 아이콘 및 동작 */
.folder > span:before {
    content: "📁";
    margin-right: 5px;
}

.folder.open > span:before {
    content: "📂";
}

.folder > ul {
    display: none;
}

.folder.open > ul {
    display: block;
}

/* 결재자 목록 */
.approver-list {
    height: 400px;
    overflow: auto;
}

#approverList tr {
    cursor: pointer;
}

#approverList tr.selected {
    background-color: #e3f2fd;
}

#approverList tr:hover {
    background-color: #f5f5f5;
}

#approverList .btn-group {
    white-space: nowrap;
}

/* 사원 표시 스타일 */
.department-head {
    font-weight: bold;
    color: #2c3e50;
    padding: 3px 0;
}

.employee {
    padding: 2px 0 2px 15px;
}

.employees {
    margin-left: 20px;
    border-left: 1px dotted #ddd;
}

/* 모달 레이아웃 */
.directory-container {
    flex: 1;
    max-width: 50%;
}

.approver-container {
    flex: 1;
}

/* 버튼 그룹 */
.action-button-group {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding: 20px;
    margin-top: 20px;
}

.action-button-group .btn {
    padding: 8px 16px;
    border-radius: 4px;
}

/* 휴가 문서 테이블 */
.vacation-table {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0;
}

.vacation-table th,
.vacation-table td {
    border: 1px solid #ddd;
    padding: 8px;
    text-align: center;
}

.vacation-table th {
    background-color: #f5f5f5;
}

/* 모달 크기 조정 */
#approvalLineModal .modal-xl {
    max-width: 1200px; /* 더 넓은 너비 설정 */
}

#approvalLineModal .modal-body {
    min-height: 500px; /* 모달 최소 높이 설정 */
}


/* 조직도 영역과 결재자 목록 영역 비율 조정 */
#approvalLineModal .col-5 {
    width: 35%;
}

#approvalLineModal .col-7 {
    width: 65%;
}

#approvalLineModal .table {
    table-layout: fixed; /* 테이블 열 너비 고정 */
}

/* 테이블 컬럼 너비 조정 */
#approvalLineModal .table th:nth-child(1) { /* 순서 */
    width: 10%;
}

#approvalLineModal .table th:nth-child(2) { /* 부서 */
    width: 25%;
}

#approvalLineModal .table th:nth-child(3) { /* 직책/이름 */
    width: 25%;
}

#approvalLineModal .table th:nth-child(4) { /* 기능 */
    width: 40%;
}

/* 텍스트 줄바꿈 방지 및 말줄임표 설정 */
#approvalLineModal .table td {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 0; /* 말줄임표가 작동하게 함 */
}

/* 버튼 그룹 스타일 조정 */
#approvalLineModal .btn-group {
    flex-wrap: nowrap;
    min-width: max-content;
}

#approvalLineModal .btn {
    padding: 0.25rem 0.5rem;
    font-size: 0.875rem;
    white-space: nowrap;
}

.approval-container {
    padding: 20px;
}

/* 폼 선택 영역 */
.form-select-area {
    width: 100%;
    margin-bottom: 20px;
}

.button-group {
    display: none !important; /* !important로 초기 상태 강제 */
    margin-bottom: 0.5rem; /* select box와 정렬을 맞추기 위한 여백 */
}

.button-group.show {
    display: flex !important;
}

/* select-box와 버튼 그룹의 정렬을 위한 컨테이너 스타일 */
.select-box-wrapper {
    margin-bottom: 0;
    display: flex;
    align-items: flex-end; /* 하단 정렬 */
}

.select-box {
    margin-bottom: 0; /* 기존 마진 제거 */
    flex-grow: 1;
}

.select-box-wrapper label {
    display: block;
    margin-bottom: 8px;
    font-weight: bold;
}

/* 라벨과 select box 간격 조정 */
.select-box label {
    margin-bottom: 0.5rem;
}

.form-select {
    width: 100%;
    padding: 8px;
    border: 1px solid #ddd;
    border-radius: 4px;
}

#approvalLineModal .modal-footer {
    padding: 1rem;
    align-items: flex-end;  /* 추가 */
}

#approvalLineModal .modal-footer > div {
    width: auto;  /* 추가: div들이 내용물 크기만큼만 차지하도록 */
}

#approvalLineModal .modal-footer .form-switch {
    padding-left: 2.5rem;
}

#approvalLineModal .form-check-input {
    width: 3rem;
    height: 1.5rem;
    margin-left: -2.5rem;
    cursor: pointer;
}

#approvalLineModal .form-check-label {
    padding-top: 0.25rem;
    font-weight: 500;
    cursor: pointer;
}

/* 반응형 처리 */
@media (max-width: 768px) {
    .document-area {
        padding: 20px;
    }
}