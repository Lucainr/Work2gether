	// 비밀번호 확인 결과 매핑
	@PostMapping
	@ResponseBody
	public Map<String, String> checkPassword(
			HttpSession session,
			RedirectAttributes redirectAttributes,
			@RequestParam("passCheck") String passCheck
			) {
		String companyId = (String)session.getAttribute("companyId");
		EmployeeVO myEmp = (EmployeeVO)session.getAttribute("myEmp");
		Map<String, String> response = new HashMap<>();
		
		if(myEmp.getEmpPass().equals(passCheck)) {
			// 비밀번호가 일치한다면,
			response.put("success", "true");
	        response.put("redirectUrl", "mypage/edit");
		} else {
			response.put("success", "false");
			response.put("message", "비밀번호가 일치하지 않습니다.");
		}
		return response;
	}
	
	
	// 비밀번호 확인창에서 비밀번호 일치시, 개인정보수정 페이지로 이동
	@GetMapping("edit")
	public String getUpdateMyInfoForm(HttpSession session, Model model) {
		EmployeeVO myEmp = (EmployeeVO) session.getAttribute("myEmp");
		model.addAttribute("myEmp", myEmp);
		return "employee/employeeUpdateForm";
	}

	@PostMapping("edit")
	public String updateMyInfo(
			@PathVariable("companyId") String companyId,
			@Validated(UpdateGroup.class) EmployeeVO updateEmp,
			@RequestParam(value = "empImgDelete", required = false) Boolean empImgDelete,
	        @RequestParam(value = "signImgDelete", required = false) Boolean signImgDelete,
			BindingResult errors,
			HttpSession session,
			RedirectAttributes redirectAttributes

	) {
		log.info(updateEmp.toString());
		if (!errors.hasErrors()) {
			// 검증에 오류가 없을 때
			
			// 이미지 삭제 요청 했을 경우 준비
			// 프로필 이미지 삭제 처리
		    if (Boolean.TRUE.equals(empImgDelete)) {
		    	empService.deleteEmpImg(updateEmp.getEmpId());
		    }

		    // 도장 이미지 삭제 처리
		    if (Boolean.TRUE.equals(signImgDelete)) {
		    	empService.deleteEmpSignImg(updateEmp.getEmpId());
		    }
			
			// 새로 인증받은 oAuth 정보가 있는지 없는지 확인해서 있으면 update
			OAuthVO oAuth = (OAuthVO) session.getAttribute("oAuth");
			if (oAuth != null) {
				// null이 아니면 새로 인증받은 oAuth 정보가 있다는 뜻, update 진행
				ServiceResult oAuthResult = oAuthService.modifyOAuth(oAuth);
				if(oAuthResult==ServiceResult.FAIL) {
					// 실패했을 경우, 이후 작업 실행하지 않고 바로 return
					redirectAttributes.addFlashAttribute("myEmp", updateEmp);
					redirectAttributes.addFlashAttribute("message", "개인정보 수정에 실패하였습니다.");
					redirectAttributes.addFlashAttribute("messageKind", "error");
					return "redirect:/" + companyId + "/mypage/edit";
				}
			}
			
			// oAuth 정보 update가 되었다면, employee 정보 update 필요
			ServiceResult empResult = empService.modifyEmployee(updateEmp);
			if (empResult == ServiceResult.OK) {
				// 둘 다 성공했으면 oAuth 정보와 employee 정보를 다시 가지고 와서 세션에 같은 이름으로 저장
				EmployeeVO modifyEmp = empService.readEmployee(updateEmp.getEmpMail());
				OAuthVO modifyOAuth = modifyEmp.getOAuth();
				session.setAttribute("myEmp", modifyEmp);
				session.setAttribute("myOAuth", modifyOAuth);
				
				redirectAttributes.addFlashAttribute("myEmp", modifyEmp);
				redirectAttributes.addFlashAttribute("message", "개인정보 수정이 완료되었습니다.");
				redirectAttributes.addFlashAttribute("messageKind", "success");
				return "redirect:/" + companyId + "/mypage/edit";
			} else {
				redirectAttributes.addFlashAttribute("myEmp", updateEmp);
				redirectAttributes.addFlashAttribute("message", "개인정보 수정에 실패하였습니다.");
				redirectAttributes.addFlashAttribute("messageKind", "error");
				return "redirect:/" + companyId + "/mypage/edit";
			}
		} else {
			// 검증에 오류가 있을 때
			redirectAttributes.addFlashAttribute("myEmp", updateEmp);
			redirectAttributes.addFlashAttribute("message", "필수 정보가 누락되었습니다.");
			redirectAttributes.addFlashAttribute("messageKind", "error");
			return "redirect:/" + companyId + "/mypage/edit";
		}

	}
}
