@charset "UTF-8";

#listtr:hover{
	background-color:rgba(24,28,33, 0.03);
}


.form-control {
    width: auto; /* input 필드의 너비 조정 */
}

.search-area{
	display: flex;
	gap: 10px;
    align-items: center;
    justify-content: flex-end;
}

.modal-body-title{
	width : 120px;
	height: 50px;
}

.modal-body-main{
	width : 1000px;
	max-width: 1000px;
}

#attach-area{
	width : 1000px;
	height: 100px;
	background-color: rgba(240, 236, 219, 0.3);
}

.th-checkbox{
	width: 60px;	
}
.th-tofrom{
	width: 240px;
}
.th-subject{
	width: 570px;
}
.th-date{
	width: 303px;
}

