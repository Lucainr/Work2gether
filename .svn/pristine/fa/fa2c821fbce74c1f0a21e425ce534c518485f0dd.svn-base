package kr.or.ddit.approval.controller;

import kr.or.ddit.approval.service.ApprovalService;
import kr.or.ddit.department.service.DepartmentService;
import kr.or.ddit.employee.service.EmployeeService;
import kr.or.ddit.employee.vo.EmployeeVO;
import kr.or.ddit.position.service.PositionService;
import kr.or.ddit.vacation.service.VacationStatusService;
import kr.or.ddit.vacation.vo.VacationStatusVO;
import kr.or.ddit.vacation.vo.VacationTypeVO;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.*;

import javax.servlet.http.HttpSession;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

@Controller
@RequestMapping("/{companyId}/approval")
@Slf4j
public class ApprovalFormController {

    @Autowired
    private ApprovalService formService;

    @Autowired
    VacationStatusService vacationStatusService;

    @Autowired
    PositionService positionService;

    @Autowired
    DepartmentService departmentService;

    @Autowired
    EmployeeService employeeService;


    // 미리보기 문서 만들기
    @PostMapping("/{apprformId}/preview")
    @ResponseBody
    public ResponseEntity<String> previewDocument(
            @PathVariable String companyId,
            @PathVariable String apprformId,
            @RequestBody Map<String, Object> requestData,
            HttpSession session) {
        EmployeeVO myEmp = (EmployeeVO) session.getAttribute("myEmp");

        //사원정보로 사원명갖고오기
        String empName = myEmp.getEmpName();

        //사원번호로 직급명 부서명만 빼오기
        Map<String, Object> name = employeeService.readEmployeePosiNameAndDeptNameByEmpId(myEmp.getEmpId());
        String posiName = (String) name.get("POSI_NAME");
        String departName = (String) name.get("DEPART_NAME");

        //템플릿 양식 가져오기
        String templateContent = formService.getFormContent(apprformId);

        Map<String, String> approvalInfoMap = new HashMap<>();
        approvalInfoMap.put("empName", empName);
        approvalInfoMap.put("posiName", posiName);
        approvalInfoMap.put("departName", departName);
        approvalInfoMap.put("templateContent", templateContent);

        switch (apprformId) {
            //휴가 신청서
            case "v01":
                String s = formService.processVacationForm(approvalInfoMap, requestData);
                return ResponseEntity.ok()
                        .contentType(MediaType.parseMediaType("text/html; charset=UTF-8"))
                        .body(s);
            //차차 추가 예정
            default :
                throw new IllegalArgumentException("이런 결재문서 양식없는데? : " + apprformId);
        }
    }


    //만약 휴가 신청서를 클릭했을때의 분기
    //나의 휴가 현황판을 비동기로 바로갖고오는코드임 - 휴가서비스와 연결
    @GetMapping("/vacation/status")
    @ResponseBody
    public VacationStatusVO getVacationStatusFromEmpId(
            HttpSession session
    ){
        // 1) session에 담긴 나의 정보를 가지고 현재 휴가 근황 조회
        EmployeeVO myEmp = (EmployeeVO) session.getAttribute("myEmp");
        return vacationStatusService.readVacationStatusThisYear(myEmp.getEmpId());
    }

    //휴가 신청서를 클릭했을때의 분기
    //휴가 종류 갖고와서 선택할때 셀렉트박스로 보여주기위한 연결
    @GetMapping("/vacation/types")
    @ResponseBody
    public List<VacationTypeVO> getVacationType(
            HttpSession session
    ){
        return vacationStatusService.readVacationTypeList();
    }

}
